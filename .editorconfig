root = true

[*]
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = space
indent_size = 4

[*.cs]
# Warnings
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1031.severity = none

# RepoQL analyzers — errors so agents can't ignore them
dotnet_diagnostic.RQL001.severity = error
dotnet_diagnostic.RQL002.severity = error
dotnet_diagnostic.RQL003.severity = error
dotnet_diagnostic.RQL004.severity = error
dotnet_diagnostic.RQL005.severity = error
dotnet_diagnostic.RQL006.severity = error
dotnet_diagnostic.RQL007.severity = error
dotnet_diagnostic.RQL008.severity = error

# Style
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
csharp_style_namespace_declarations = file_scoped
csharp_prefer_braces = when_multiline
