  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Client\" />
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
      <PackageReference Include="Grpc.HealthCheck" Version="2.62.0" />
      <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
      <PackageReference Include="Google.Protobuf" Version="3.26.1" />
      <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RepoQL.Contracts\RepoQL.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\repoql.proto">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
  </ItemGroup>


</Project>
