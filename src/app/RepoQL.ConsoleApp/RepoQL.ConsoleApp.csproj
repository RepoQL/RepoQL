<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.5.3</Version>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <OutputType>Exe</OutputType>
        <AssemblyName>repoql</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <IsPackable>true</IsPackable>
        <ToolCommandName>repoql</ToolCommandName>
        <PackageId>RepoQL.Tool</PackageId>
        <PackageOutputPath>$(ArtifactsDirectory)/packages</PackageOutputPath>
        <RollForward>Major</RollForward>
        <PublishSingleFile>true</PublishSingleFile>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <StripSymbols>true</StripSymbols>
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- Keep trimming enabled but manually preserve native duckdb below -->
        <PublishTrimmed>true</PublishTrimmed>
        <!-- keep symbols out of nupkg -->
        <DebugType>none</DebugType>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <ApplicationIcon>..\..\..\repoql.ico</ApplicationIcon>
        <UserSecretsId>7685a2b1-6ca7-4a99-ae8f-e6f4cb6608d7</UserSecretsId>
    </PropertyGroup>
    
    <PropertyGroup Condition="$(RuntimeIdentifier) != ''">
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
      <!-- GC tuning for shared developer machine profile -->
      <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="1" />
      <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
      <RuntimeHostConfigurationOption Include="System.GC.HighMemoryPercent" Value="4B" />
    </ItemGroup>

    <ItemGroup>
      <!-- Transitive from RepoQL.Formats.DotNet; explicit here to satisfy Microsoft.Build.Locator MSBL001 -->
      <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
      <PackageReference Include="ConsoleAppFramework">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="DuckDB.NET.Data.Full" GeneratePathProperty="true" />
      <PackageReference Include="LibGit2Sharp.NativeBinaries" GeneratePathProperty="true" />
      <PackageReference Include="JetBrains.Annotations" />
      <PackageReference Include="Microsoft.ML.OnnxRuntime" GeneratePathProperty="true" />
      <PackageReference Include="Microsoft.Extensions.Hosting" />
        <!-- Spectre.Console comes transitively from RepoQL.Client -->
        <!-- ModelContextProtocol comes transitively from RepoQL.McpServer -->
      <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
      <PackageReference Include="Microsoft.Diagnostics.Runtime" />
      <PackageReference Include="Google.Protobuf" />
      <PackageReference Include="Grpc.AspNetCore" />
      <PackageReference Include="Grpc.AspNetCore.Server" />
      <PackageReference Include="Grpc.HealthCheck" />
      <PackageReference Include="Serilog.AspNetCore" />
      <PackageReference Include="Serilog.Enrichers.Process" />
      <PackageReference Include="Serilog.Sinks.File" />
      <PackageReference Include="OpenTelemetry" />
      <PackageReference Include="OpenTelemetry.Api" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
      <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    </ItemGroup>

    <!-- Ensure duckdb native library is always copied alongside trimmed single-file publishes -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-x64\native\duckdb.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-x64\native\duckdb.dll')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>duckdb.dll</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-arm64\native\duckdb.dll" Condition="'$(RuntimeIdentifier)' == 'win-arm64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-arm64\native\duckdb.dll')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>duckdb.dll</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\osx\native\libduckdb.dylib" Condition="('$(RuntimeIdentifier)' == 'osx-arm64' or '$(RuntimeIdentifier)' == 'osx-x64') and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\osx\native\libduckdb.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libduckdb.dylib</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-x64\native\libduckdb.so" Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-x64\native\libduckdb.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libduckdb.so</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-arm64\native\libduckdb.so" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-arm64\native\libduckdb.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libduckdb.so</Link>
        </Content>
        <!-- LibGit2Sharp native binaries -->
        <Content Include="$(PkgLibGit2Sharp_NativeBinaries)\runtimes\win-x64\native\git2-a418d9d.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(PkgLibGit2Sharp_NativeBinaries)\runtimes\win-x64\native\git2-a418d9d.dll')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>git2-a418d9d.dll</Link>
        </Content>
        <Content Include="$(PkgLibGit2Sharp_NativeBinaries)\runtimes\win-arm64\native\git2-a418d9d.dll" Condition="'$(RuntimeIdentifier)' == 'win-arm64' and Exists('$(PkgLibGit2Sharp_NativeBinaries)\runtimes\win-arm64\native\git2-a418d9d.dll')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>git2-a418d9d.dll</Link>
        </Content>
        <Content Include="$(PkgLibGit2Sharp_NativeBinaries)\runtimes\osx-arm64\native\libgit2-a418d9d.dylib" Condition="'$(RuntimeIdentifier)' == 'osx-arm64' and Exists('$(PkgLibGit2Sharp_NativeBinaries)\runtimes\osx-arm64\native\libgit2-a418d9d.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libgit2-a418d9d.dylib</Link>
        </Content>
        <Content Include="$(PkgLibGit2Sharp_NativeBinaries)\runtimes\osx-x64\native\libgit2-a418d9d.dylib" Condition="'$(RuntimeIdentifier)' == 'osx-x64' and Exists('$(PkgLibGit2Sharp_NativeBinaries)\runtimes\osx-x64\native\libgit2-a418d9d.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libgit2-a418d9d.dylib</Link>
        </Content>
        <Content Include="$(PkgLibGit2Sharp_NativeBinaries)\runtimes\linux-x64\native\libgit2-a418d9d.so" Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(PkgLibGit2Sharp_NativeBinaries)\runtimes\linux-x64\native\libgit2-a418d9d.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libgit2-a418d9d.so</Link>
        </Content>
        <Content Include="$(PkgLibGit2Sharp_NativeBinaries)\runtimes\linux-arm64\native\libgit2-a418d9d.so" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' and Exists('$(PkgLibGit2Sharp_NativeBinaries)\runtimes\linux-arm64\native\libgit2-a418d9d.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libgit2-a418d9d.so</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\RepoQL.Client\RepoQL.Client.csproj" />
    <ProjectReference Include="..\RepoQL.McpServer\RepoQL.McpServer.csproj" />
    <ProjectReference Include="..\..\data\RepoQL.Data.DuckDB\RepoQL.Data.DuckDB.csproj" />
    <ProjectReference Include="..\..\pipeline\RepoQL.Indexing\RepoQL.Indexing.csproj" />
    <ProjectReference Include="..\..\query\RepoQL.Read\RepoQL.Read.csproj" />
    <ProjectReference Include="..\..\query\RepoQL.Query\RepoQL.Query.csproj" />
    <ProjectReference Include="..\..\query\RepoQL.Explain\RepoQL.Explain.csproj" />
    <ProjectReference Include="..\..\integrations\RepoQL.Import\RepoQL.Import.csproj" />
  </ItemGroup>

    
    
    <!-- Prefer a prebuilt zip committed once; otherwise embed individual model files -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\EmbeddingsModel.zip" LogicalName="Embeddings.Model.embeddings.zip" Condition="Exists('$(MSBuildThisFileDirectory)Resources\\EmbeddingsModel.zip')" />
  </ItemGroup>

    <!-- Include platform native onnxruntime binaries for non-Windows self-contained publishes. -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.dylib</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime_providers_shared.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime_providers_shared.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.dylib</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.dylib</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime_providers_shared.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime_providers_shared.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.dylib</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.so</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime_providers_shared.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime_providers_shared.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.so</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.so</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime_providers_shared.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime_providers_shared.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.so</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\..\repoql.ico">
        <Link>repoql.ico</Link>
      </None>
      <None Update="appsettings.Development.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <DashboardSource Include="$(RepositoryRoot)dashboard/src/**/*" />
      <DashboardSource Include="$(RepositoryRoot)dashboard/index.html" />
      <DashboardSource Include="$(RepositoryRoot)dashboard/vite.config.ts" />
      <DashboardSource Include="$(RepositoryRoot)dashboard/tsconfig.json" />
      <DashboardSource Include="$(RepositoryRoot)dashboard/package.json" />
      <DashboardSource Include="$(RepositoryRoot)dashboard/package-lock.json" />
    </ItemGroup>

    <Target Name="DashboardNpmInstall" BeforeTargets="BuildDashboard"
            Condition="!Exists('$(RepositoryRoot)dashboard/node_modules/.package-lock.json')">
      <Exec Command="npm ci --silent" WorkingDirectory="$(RepositoryRoot)dashboard" />
    </Target>

    <Target Name="BuildDashboard" BeforeTargets="BeforeBuild"
            Inputs="@(DashboardSource)"
            Outputs="$(RepositoryRoot)dashboard/dist/index.html">
      <Exec Command="npm run build" WorkingDirectory="$(RepositoryRoot)dashboard" />
    </Target>

    <!-- ⚠ WARNING — DO NOT CHANGE BeforeTargets="AssignTargetPaths" ⚠

         This target hook is the ONLY correct injection point for dynamically-generated
         EmbeddedResource items in SDK-style projects. It was found after 4 failed attempts.
         Every "obvious" alternative silently breaks the manifest and the dashboard disappears
         from published binaries with no build error.

         Approaches that DO NOT work and why:
         1. BeforeTargets="PrepareResourceNames"
            → Runs AFTER DependsOnTargets (CreateManifestResourceNames already ran).
              Dashboard files get empty ResourcePath in the manifest.
         2. PrepareResourceNamesDependsOn injection from csproj
            → SDK's Microsoft.Common.targets does a direct assignment that overwrites
              the csproj value. Your addition is silently lost.
         3. BeforeTargets="CreateManifestResourceNames"
            → Target runs, files are added to @(EmbeddedResource), BUT CreateManifestResourceNames
              does a Remove-all/Replace cycle via CreateCSharpManifestResourceName task. Items that
              didn't go through AssignTargetPaths are missing internal metadata and get SILENTLY
              DROPPED. The manifest generates without them. No error, no warning.
         4. BeforeTargets="_CalculateEmbeddedFilesManifestInputs"
            → NuGet-defined target that MSBuild can't resolve by name from the csproj.

         BeforeTargets="AssignTargetPaths" works because dashboard files enter the pipeline
         at the earliest point and flow through the full SDK chain:
         AssignTargetPaths → CreateManifestResourceNames → _CalculateEmbeddedFilesManifestInputs
         → _GenerateEmbeddedFilesManifest (AfterTargets="PrepareResourceNames"). -->
    <Target Name="RegisterDashboardEmbeddedResources"
            DependsOnTargets="BuildDashboard"
            BeforeTargets="AssignTargetPaths">
      <ItemGroup>
        <Content Remove="$(RepositoryRoot)dashboard/dist/**" />
        <EmbeddedResource Remove="$(RepositoryRoot)dashboard/dist/**" />
        <DashboardDistFile Include="$(RepositoryRoot)dashboard/dist/**"
                           Condition="Exists('$(RepositoryRoot)dashboard/dist/index.html')" />
        <!-- Use forward slashes: on Linux, MSBuild's manifest generator doesn't split
             on backslash, producing flat filenames (wwwroot\index.html) instead of a
             directory tree. ManifestEmbeddedFileProvider then can't find the wwwroot
             directory and Resolve() returns null. Forward slashes work on both platforms. -->
        <Content Include="@(DashboardDistFile)"
                 Link="wwwroot/%(DashboardDistFile.RecursiveDir)%(DashboardDistFile.Filename)%(DashboardDistFile.Extension)"
                 TargetPath="wwwroot/%(DashboardDistFile.RecursiveDir)%(DashboardDistFile.Filename)%(DashboardDistFile.Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="Always"
                 ExcludeFromSingleFile="false" />
        <EmbeddedResource Include="@(DashboardDistFile)"
                          Link="wwwroot/%(DashboardDistFile.RecursiveDir)%(DashboardDistFile.Filename)%(DashboardDistFile.Extension)" />
      </ItemGroup>
    </Target>

    <!-- Generate help:// snapshot for Release builds so documentation is queryable on first request -->
    <Target Name="GenerateHelpSnapshot" BeforeTargets="BeforeBuild"
            Condition="'$(Configuration)' == 'Release'">
      <PropertyGroup>
        <_SnapshotGeneratorProject>$(RepositoryRoot)src/tools/RepoQL.SnapshotGenerator/RepoQL.SnapshotGenerator.csproj</_SnapshotGeneratorProject>
        <_SnapshotOutputDir>$(RepositoryRoot)artifacts/obj/RepoQL.ConsoleApp/_snapshot/</_SnapshotOutputDir>
        <_SnapshotOutputPath>$(_SnapshotOutputDir)help-docs-snapshot.json</_SnapshotOutputPath>
      </PropertyGroup>
      <MakeDir Directories="$(_SnapshotOutputDir)" />
      <Exec Command="dotnet run --project &quot;$(_SnapshotGeneratorProject)&quot; -c $(Configuration) --no-launch-profile -- &quot;$(RepositoryRoot)src/app/RepoQL.Documentation&quot; &quot;$(_SnapshotOutputPath)&quot; --version $(Version)" />
      <ItemGroup>
        <EmbeddedResource Include="$(_SnapshotOutputPath)" LogicalName="HelpDocsSnapshot.json" />
      </ItemGroup>
    </Target>

</Project>
