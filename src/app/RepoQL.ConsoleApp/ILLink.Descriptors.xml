<?xml version="1.0" encoding="utf-8"?>
<!--
  IL Linker configuration for preserving types discovered via reflection during trimming.
  Command classes are discovered via assembly scanning by CommandRegistry.
-->
<linker>
  <assembly fullname="RepoQL.Client">
    <type fullname="RepoQL.Client.CommandImplementations.*" preserve="all" />
  </assembly>
</linker>
