@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject RepoQlConnectionManager ConnectionManager
@inject HostStatusStore HostStatusStore
@inject INavigationState NavigationState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <header class="app-header">
        <div class="brand">RepoQL</div>
        <NavMenu />
        <PipelineStatusBar />
        <div class="status-stack">
            <span class="@ConnectionBadgeClass">@_connectionState.Description</span>
            <span class="status-message">@_hostStatus.Message</span>
        </div>
    </header>

    <main class="app-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private RepoQlConnectionManager.ConnectionState _connectionState = RepoQlConnectionManager.ConnectionState.Create(false, "Not connected");
    private HostStatusSnapshot _hostStatus = HostStatusSnapshot.Offline("Waiting for host status");
    private IJSObjectReference? _keyboardModule;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override void OnInitialized()
    {
        _connectionState = ConnectionManager.State;
        _hostStatus = HostStatusStore.Snapshot;

        ConnectionManager.StateChanged += OnConnectionStateChanged;
        HostStatusStore.SnapshotChanged += OnHostStatusChanged;

        ConnectionManager.StartWarmup();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _keyboardModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                await _keyboardModule.InvokeVoidAsync("initKeyboardShortcuts", _dotNetRef);
            }
            catch
            {
                // JS interop not available (prerendering)
            }
        }
    }

    [JSInvokable]
    public void OnGoBack()
    {
        if (NavigationState.CanGoBack)
        {
            NavigationState.GoBack();
            var entry = NavigationState.Current;
            var uri = entry.View;
            if (entry.Params?.Uri is not null)
            {
                uri += $"?uri={Uri.EscapeDataString(entry.Params.Uri)}";
            }
            NavigationManager.NavigateTo("/" + uri);
        }
    }

    [JSInvokable]
    public void OnExecute()
    {
        // Broadcast execute event - components can subscribe
        // For now this is handled by individual components
    }

    private void OnConnectionStateChanged(object? sender, RepoQlConnectionManager.ConnectionState state)
    {
        _connectionState = state;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnHostStatusChanged(object? sender, HostStatusSnapshot snapshot)
    {
        _hostStatus = snapshot;
        _ = InvokeAsync(StateHasChanged);
    }

    private string ConnectionBadgeClass => _connectionState.IsConnected ? "badge badge-online" : "badge badge-offline";

    public async ValueTask DisposeAsync()
    {
        ConnectionManager.StateChanged -= OnConnectionStateChanged;
        HostStatusStore.SnapshotChanged -= OnHostStatusChanged;

        if (_keyboardModule is not null)
        {
            try
            {
                await _keyboardModule.InvokeVoidAsync("dispose");
                await _keyboardModule.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }

        _dotNetRef?.Dispose();
    }
}
