@page "/"
@inject StatsService StatsService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Overview</PageTitle>

<h1>Repository Overview</h1>

@if (_loading)
{
    <p class="loading">Loading statistics...</p>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="error-callout">@_errorMessage</div>
}
else
{
    <!-- High-Level Stats Cards -->
    <div class="stats-grid">
        <div class="card stats-card compact">
            <span class="stats-label">Files</span>
            <span class="stats-value">@_overview.TotalFiles.ToString("N0")</span>
        </div>
        <div class="card stats-card compact">
            <span class="stats-label">Nodes</span>
            <span class="stats-value">@_overview.TotalNodes.ToString("N0")</span>
        </div>
        <div class="card stats-card compact">
            <span class="stats-label">Edges</span>
            <span class="stats-value">@_overview.TotalEdges.ToString("N0")</span>
        </div>
        <div class="card stats-card compact">
            <span class="stats-label">Annotations</span>
            <span class="stats-value">@_overview.TotalAnnotations.ToString("N0")</span>
        </div>
    </div>

    <!-- Health Checks -->
    @if (_healthChecks.Checks.Any())
    {
        <div class="card" style="margin-bottom: 2rem;">
            <h2>Health Checks</h2>
            @foreach (var check in _healthChecks.Checks)
            {
                var badgeClass = check.Severity switch
                {
                    HealthCheckSeverity.Success => "badge badge-online",
                    HealthCheckSeverity.Warning => "badge-warning",
                    HealthCheckSeverity.Error => "badge badge-offline",
                    _ => "badge"
                };
                var icon = check.Severity switch
                {
                    HealthCheckSeverity.Success => "✅",
                    HealthCheckSeverity.Warning => "⚠️",
                    HealthCheckSeverity.Error => "❌",
                    _ => ""
                };

                <div style="margin-bottom: 0.75rem;">
                    <span class="@badgeClass" style="margin-right: 0.5rem;">@icon</span>
                    <strong>@check.Message</strong>
                    @if (check.Samples.Any())
                    {
                        <div style="margin-left: 2rem; margin-top: 0.25rem; font-size: 0.85rem; color: #64748b;">
                            Samples: @string.Join(", ", check.Samples.Take(3))
                            @if (check.Samples.Count > 3)
                            {
                                <span>, ...</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Charts Row -->
    <div class="stats-grid" style="margin-bottom: 2.5rem;">
        <!-- Media Type Chart -->
        <div class="card stats-card stats-chart">
            <h3>Media Types</h3>
            @if (_overview.MediaBreakdown.Any())
            {
                <MudChart ChartType="ChartType.Donut"
                          InputData="_overview.MediaBreakdown.Select(m => m.Value).ToArray()"
                          InputLabels="_overview.MediaBreakdown.Select(m => m.Label).ToArray()"
                          Width="100%"
                          Height="260px" />
            }
            else
            {
                <p class="stats-chart-empty">No media types found</p>
            }
        </div>

        <!-- Node Kinds Chart (Top 10) -->
        <div class="card stats-card stats-chart">
            <h3>Node Kinds (Top 10)</h3>
            @if (_nodeKindsTop10.Any())
            {
                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="@(new List<ChartSeries> { new ChartSeries { Name = "Count", Data = _nodeKindsTop10.Select(n => (double)n.Count).ToArray() } })"
                          XAxisLabels="_nodeKindsTop10.Select(n => n.Kind).ToArray()"
                          Width="100%"
                          Height="260px" />
            }
            else
            {
                <p class="stats-chart-empty">No nodes found</p>
            }
        </div>

        <!-- Edge Types Chart -->
        <div class="card stats-card stats-chart">
            <h3>Edge Types</h3>
            @if (_edgeTypes.Any())
            {
                <MudChart ChartType="ChartType.Pie"
                          InputData="_edgeTypes.Select(e => e.Percentage).ToArray()"
                          InputLabels="@(_edgeTypes.Select(e => $"{e.Type} ({e.Count})").ToArray())"
                          Width="100%"
                          Height="260px" />
            }
            else
            {
                <p class="stats-chart-empty">No edges found</p>
            }
        </div>
    </div>

    <!-- Format Breakdown Table -->
    <div class="card" style="margin-bottom: 2rem;">
        <h2>Format Breakdown</h2>
        <MudTable T="MediaTypeDetail" Items="_mediaTypeDetails" Dense="true" Hover="true" class="stats-table">
            <HeaderContent>
                <MudTh>Media Type</MudTh>
                <MudTh Style="text-align: right;">Files</MudTh>
                <MudTh Style="text-align: right;">X-ray Coverage</MudTh>
                <MudTh Style="text-align: center;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.MediaLabel</MudTd>
                <MudTd Style="text-align: right;">@context.FileCount</MudTd>
                <MudTd Style="text-align: right;">
                    @context.XRayCoverage%
                    <span style="font-size: 0.75rem; color: #64748b;">
                        (H:@context.WithHeadline S:@context.WithSummary T:@context.WithStructure)
                    </span>
                </MudTd>
                <MudTd Style="text-align: center;">
                    @if (!string.IsNullOrEmpty(context.SampleUri))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => NavigateToExplorer(context.SampleUri))">
                            View Random
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>

    <!-- Node Kinds Table (Full List) -->
    <div class="card" style="margin-bottom: 2rem;">
        <h2>Node Kinds (All)</h2>
        <MudTable T="NodeKindStat" Items="_nodeKindsAll" Dense="true" Hover="true" class="stats-table">
            <HeaderContent>
                <MudTh>Kind</MudTh>
                <MudTh Style="text-align: right;">Count</MudTh>
                <MudTh Style="text-align: right;">%</MudTh>
                <MudTh Style="text-align: center;">Sample</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Kind</MudTd>
                <MudTd Style="text-align: right;">@context.Count.ToString("N0")</MudTd>
                <MudTd Style="text-align: right;">@context.Percentage.ToString("F1")%</MudTd>
                <MudTd Style="text-align: center;">
                    @if (!string.IsNullOrEmpty(context.SampleUri))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => NavigateToExplorerUri(context.SampleUri))">
                            View
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>

    <!-- Annotations Table (if any) -->
    @if (_annotations.Any())
    {
        <div class="card">
            <h2>Annotations</h2>
            <MudTable T="AnnotationStat" Items="_annotations" Dense="true" Hover="true" class="stats-table">
                <HeaderContent>
                    <MudTh>Rule ID</MudTh>
                    <MudTh>Severity</MudTh>
                    <MudTh Style="text-align: right;">Count</MudTh>
                    <MudTh Style="text-align: right;">Files</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RuleId</MudTd>
                    <MudTd>
                        <span class="badge" style="@GetSeverityStyle(context.Severity)">@context.Severity</span>
                    </MudTd>
                    <MudTd Style="text-align: right;">@context.Count</MudTd>
                    <MudTd Style="text-align: right;">@context.FileCount</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
}

@code {
    private bool _loading = true;
    private string? _errorMessage;
    private StatsOverview _overview = new(0, 0, 0, 0, Array.Empty<MediaSlice>(), Array.Empty<AnnotationSummary>());
    private List<MediaTypeDetail> _mediaTypeDetails = new();
    private List<NodeKindStat> _nodeKindsTop10 = new();
    private List<NodeKindStat> _nodeKindsAll = new();
    private List<EdgeTypeStat> _edgeTypes = new();
    private List<AnnotationStat> _annotations = new();
    private HealthCheckResults _healthChecks = new(Array.Empty<HealthCheck>());
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();

        _loading = true;
        _errorMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Load all stats in parallel
            var overviewTask = StatsService.GetOverviewAsync(_loadCts.Token);
            var mediaDetailsTask = StatsService.GetMediaTypeDetailsAsync(_loadCts.Token);
            var nodeKindsTop10Task = StatsService.GetNodeKindStatsAsync(limit: 10, _loadCts.Token);
            var nodeKindsAllTask = StatsService.GetNodeKindStatsAsync(limit: 0, _loadCts.Token);
            var edgeTypesTask = StatsService.GetEdgeTypeStatsAsync(_loadCts.Token);
            var annotationsTask = StatsService.GetAnnotationStatsAsync(_loadCts.Token);
            var healthChecksTask = StatsService.GetHealthChecksAsync(_loadCts.Token);

            await Task.WhenAll(
                overviewTask,
                mediaDetailsTask,
                nodeKindsTop10Task,
                nodeKindsAllTask,
                edgeTypesTask,
                annotationsTask,
                healthChecksTask).ConfigureAwait(false);

            await InvokeAsync(() =>
            {
                _overview = overviewTask.Result;
                _mediaTypeDetails = mediaDetailsTask.Result.ToList();
                _nodeKindsTop10 = nodeKindsTop10Task.Result.ToList();
                _nodeKindsAll = nodeKindsAllTask.Result.ToList();
                _edgeTypes = edgeTypesTask.Result.ToList();
                _annotations = annotationsTask.Result.ToList();
                _healthChecks = healthChecksTask.Result;
            });
        }
        catch (OperationCanceledException)
        {
            // Ignored
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _errorMessage = ex.GetBaseException().Message;
            });
        }
        finally
        {
            await InvokeAsync(() =>
            {
                _loading = false;
                StateHasChanged();
            });
        }
    }

    private void NavigateToExplorer(string documentUri)
    {
        // TODO: Once deep linking is added, pass the document URI as query param
        // For now, just navigate to explorer
        Navigation.NavigateTo("/explorer");
    }

    private void NavigateToExplorerUri(string nodeUri)
    {
        // Extract document URI from node URI (format: file:///path#fragment)
        var docUri = nodeUri.Contains('#') ? nodeUri.Split('#')[0] : nodeUri;
        NavigateToExplorer(docUri);
    }

    private string GetSeverityStyle(string severity)
    {
        return severity.ToLowerInvariant() switch
        {
            "error" => "background-color: #d9534f; color: #ffffff;",
            "warning" => "background-color: #f59e0b; color: #1f2937;",
            "info" => "background-color: #3b82f6; color: #ffffff;",
            _ => "background-color: #e2e8f0; color: #1f2937;"
        };
    }

    void IDisposable.Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
