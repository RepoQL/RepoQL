@page "/"
@inject HostStatusStore StatusStore
@inject StatsService StatsService
@inject NavigationManager Navigation
@inject OperationsService OperationsService
@implements IDisposable

<PageTitle>RepoQL Dashboard</PageTitle>

<!-- Live Status Bar -->
<div class="status-bar @GetStatusBarClass()">
    <div class="status-indicator">
        <span class="status-dot @GetStatusDotClass()"></span>
        <span class="status-text">@GetStatusText()</span>
    </div>
    <div class="status-details">
        @if (_pipelineStatus is not null)
        {
            <span class="status-pipeline">@GetPipelineText()</span>
        }
        @if (_snapshot.UpdatedAt != default)
        {
            <span class="status-updated">Updated @GetTimeSince(_snapshot.UpdatedAt)</span>
        }
    </div>
</div>

<!-- Key Metrics + Quick Search -->
<div class="metrics-row">
    <div class="metric-card">
        <span class="metric-value">@_overview.TotalFiles.ToString("N0")</span>
        <span class="metric-label">Files</span>
    </div>
    <div class="metric-card">
        <span class="metric-value">@_exploreCoverage%</span>
        <span class="metric-label">X-ray Coverage</span>
    </div>
    <div class="metric-card">
        <span class="metric-value @(_embeddingsReady ? "ready" : "pending")">@(_embeddingsReady ? "Ready" : "Pending")</span>
        <span class="metric-label">Embeddings</span>
    </div>
    <div class="search-card">
        <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Quick search..." @onkeypress="HandleSearchKeyPress" />
        <button class="search-btn" @onclick="NavigateToXray">Search</button>
    </div>
</div>

<!-- Pipeline + Health -->
<div class="dashboard-grid">
    <!-- Pipeline View -->
    <div class="card pipeline-card">
        <h2>Pipeline</h2>
        @if (_pipelineStatus is not null)
        {
            <PipelineView HotPath="@_pipelineStatus.HotPath" IdleProcessing="@_pipelineStatus.IdleProcessing" />
        }
        else
        {
            <div class="pipeline-loading">Waiting for status...</div>
        }
    </div>

    <!-- Health Panel -->
    <div class="card health-card">
        <h2>Health</h2>
        @if (_healthChecks.Checks.Any(c => c.Severity != HealthCheckSeverity.Success))
        {
            <div class="health-issues">
                @foreach (var check in _healthChecks.Checks.Where(c => c.Severity != HealthCheckSeverity.Success))
                {
                    var icon = check.Severity == HealthCheckSeverity.Warning ? "!!" : "x";
                    var badgeClass = check.Severity == HealthCheckSeverity.Warning ? "badge-warning" : "badge-error";
                    <div class="health-item">
                        <span class="badge @badgeClass">@icon</span>
                        <span class="health-message">@check.Message</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="health-ok">
                <span class="badge badge-online">OK</span>
                <span>All systems healthy</span>
            </div>
        }
    </div>
</div>

<!-- Index Summary -->
<div class="card summary-card">
    <h2>Index Summary</h2>
    @if (_mediaBreakdown.Any())
    {
        <div class="media-bar">
            @foreach (var item in _mediaBreakdown.Take(5))
            {
                var widthPct = (_overview.TotalFiles > 0) ? (item.Value / _overview.TotalFiles * 100) : 0;
                <div class="media-segment" style="width: @widthPct.ToString("F1")%;" title="@item.Label: @((int)item.Value) files">
                    <span class="media-label">@item.Label</span>
                </div>
            }
            @if (_mediaBreakdown.Count > 5)
            {
                var otherCount = _mediaBreakdown.Skip(5).Sum(m => m.Value);
                var otherPct = (_overview.TotalFiles > 0) ? (otherCount / _overview.TotalFiles * 100) : 0;
                <div class="media-segment other" style="width: @otherPct.ToString("F1")%;" title="Other: @((int)otherCount) files">
                    <span class="media-label">Other</span>
                </div>
            }
        </div>
        <div class="media-legend">
            @foreach (var item in _mediaBreakdown.Take(5))
            {
                <span class="legend-item">@item.Label (@((int)item.Value))</span>
            }
            @if (_mediaBreakdown.Count > 5)
            {
                <span class="legend-item">+@(_mediaBreakdown.Count - 5) more</span>
            }
        </div>
    }
    else
    {
        <p class="no-data">No files indexed yet</p>
    }
</div>

<!-- Action Buttons -->
<div class="action-row">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/xray"))">
        Search with Xray
    </MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/status"))">
        Operations
    </MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/stats"))">
        Detailed Stats
    </MudButton>
</div>

<style>
    .status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        transition: background-color 0.3s;
    }

    .status-bar.online {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border: 1px solid #86efac;
    }

    .status-bar.offline {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border: 1px solid #fca5a5;
    }

    .status-bar.busy {
        background: linear-gradient(135deg, #fefce8 0%, #fef3c7 100%);
        border: 1px solid #fde047;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .status-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    .status-dot.online { background-color: #22c55e; }
    .status-dot.offline { background-color: #ef4444; }
    .status-dot.busy { background-color: #f59e0b; animation: pulse 1s infinite; }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    .status-text {
        font-weight: 600;
        font-size: 1rem;
    }

    .status-details {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
        color: #6b7280;
    }

    .metrics-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr) 2fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .metric-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 1rem;
        text-align: center;
    }

    .metric-value {
        display: block;
        font-size: 1.75rem;
        font-weight: 700;
        color: #1f2937;
    }

    .metric-value.ready { color: #22c55e; }
    .metric-value.pending { color: #f59e0b; }

    .metric-label {
        font-size: 0.8rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .search-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 1rem;
        display: flex;
        gap: 0.5rem;
    }

    .search-card input {
        flex: 1;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .search-btn {
        padding: 0.5rem 1rem;
        background: #245dc1;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
    }

    .search-btn:hover {
        background: #1e4fa8;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .pipeline-card, .health-card {
        min-height: 300px;
    }

    .pipeline-card h2, .health-card h2, .summary-card h2 {
        margin-top: 0;
        margin-bottom: 1rem;
        font-size: 1.1rem;
    }

    .pipeline-loading {
        color: #9ca3af;
        text-align: center;
        padding: 2rem;
    }

    .health-ok {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #059669;
    }

    .health-issues {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .health-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .summary-card {
        margin-bottom: 1.5rem;
    }

    .media-bar {
        display: flex;
        height: 32px;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 0.75rem;
    }

    .media-segment {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        font-size: 0.7rem;
        color: white;
        font-weight: 500;
        overflow: hidden;
    }

    .media-segment:nth-child(1) { background: #3b82f6; }
    .media-segment:nth-child(2) { background: #22c55e; }
    .media-segment:nth-child(3) { background: #f59e0b; }
    .media-segment:nth-child(4) { background: #8b5cf6; }
    .media-segment:nth-child(5) { background: #ec4899; }
    .media-segment.other { background: #9ca3af; }

    .media-label {
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
        padding: 0 4px;
    }

    .media-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.8rem;
        color: #6b7280;
    }

    .no-data {
        color: #9ca3af;
        text-align: center;
    }

    .action-row {
        display: flex;
        gap: 1rem;
    }

    .badge-warning {
        background-color: #f59e0b;
        color: white;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .badge-error {
        background-color: #ef4444;
        color: white;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    @@media (max-width: 900px) {
        .metrics-row {
            grid-template-columns: repeat(2, 1fr);
        }
        .search-card {
            grid-column: span 2;
        }
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private HostStatusSnapshot _snapshot = HostStatusSnapshot.Offline("Initializing...");
    private PipelineStatusEvent? _pipelineStatus;
    private StatsOverview _overview = new(0, 0, 0, 0, Array.Empty<MediaSlice>(), Array.Empty<AnnotationSummary>());
    private List<MediaSlice> _mediaBreakdown = new();
    private HealthCheckResults _healthChecks = new(Array.Empty<HealthCheck>());
    private int _exploreCoverage;
    private bool _embeddingsReady;
    private string _searchQuery = "";
    private CancellationTokenSource? _loadCts;
    private Timer? _refreshTimer;
    private bool _pipelineWasActive;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to status updates
        _snapshot = StatusStore.Snapshot;
        _pipelineStatus = StatusStore.PipelineStatus;

        StatusStore.SnapshotChanged += OnSnapshotChanged;
        StatusStore.PipelineStatusChanged += OnPipelineStatusChanged;
        StatusStore.StatsChanged += OnStatsChanged;

        // Load initial data
        await LoadDataAsync();

        // Refresh stats when pipeline becomes idle (finished processing)
        _refreshTimer = new Timer(async _ => await CheckAndRefreshStats(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task CheckAndRefreshStats()
    {
        var isActive = _pipelineStatus != null && !_pipelineStatus.Ready;

        // Refresh when pipeline transitions from active to idle
        if (_pipelineWasActive && !isActive)
        {
            await LoadDataAsync();
        }

        _pipelineWasActive = isActive;
    }

    private void OnSnapshotChanged(object? sender, HostStatusSnapshot snapshot)
    {
        _snapshot = snapshot;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPipelineStatusChanged(object? sender, PipelineStatusEvent status)
    {
        _pipelineStatus = status;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStatsChanged(object? sender, StatsSnapshotEvent stats)
    {
        _exploreCoverage = stats.ExploreCoveragePercent;
        _embeddingsReady = stats.EmbeddingsReady;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();

        try
        {
            var overviewTask = StatsService.GetOverviewAsync(_loadCts.Token);
            var healthTask = StatsService.GetHealthChecksAsync(_loadCts.Token);
            var embeddingsTask = StatsService.AreEmbeddingsReadyAsync(_loadCts.Token);
            var xrayTask = StatsService.GetExploreCoverageAsync(_loadCts.Token);

            await Task.WhenAll(overviewTask, healthTask, embeddingsTask, xrayTask).ConfigureAwait(false);

            await InvokeAsync(() =>
            {
                _overview = overviewTask.Result;
                _mediaBreakdown = _overview.MediaBreakdown.ToList();
                _healthChecks = healthTask.Result;
                _embeddingsReady = embeddingsTask.Result;
                _exploreCoverage = xrayTask.Result;
            });
        }
        catch (OperationCanceledException) { }
        catch (Exception) { }
    }

    private string GetStatusBarClass() => _snapshot.IsAvailable
        ? (_pipelineStatus?.Ready == true ? "online" : "busy")
        : "offline";

    private string GetStatusDotClass() => _snapshot.IsAvailable
        ? (_pipelineStatus?.Ready == true ? "online" : "busy")
        : "offline";

    private string GetStatusText() => _snapshot.IsAvailable ? "Connected" : "Disconnected";

    private string GetPipelineText()
    {
        if (_pipelineStatus is null) return "";
        if (_pipelineStatus.Ready) return "Pipeline: Idle";
        if (_pipelineStatus.Reindexing) return "Pipeline: Reindexing";

        var busyCount = _pipelineStatus.Stages.Count(s => s.Busy || s.Queued > 0 || s.InProgress > 0);
        return busyCount > 0 ? $"Pipeline: Processing ({busyCount} stages)" : "Pipeline: Idle";
    }

    private string GetTimeSince(DateTimeOffset time)
    {
        var diff = DateTimeOffset.UtcNow - time;
        if (diff.TotalSeconds < 5) return "just now";
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        return $"{(int)diff.TotalHours}h ago";
    }

    private static string GetStageName(PipelineStage stage) => stage switch
    {
        PipelineStage.Discovery => "Discovery",
        PipelineStage.Indexing => "Parsing",
        PipelineStage.Analysis => "Analysis",
        _ => stage.ToString()
    };

    private static string FormatDuration(double ms)
    {
        if (ms < 1) return "<1ms";
        if (ms < 1000) return $"{ms:F0}ms";
        if (ms < 60000) return $"{ms / 1000:F1}s";
        return $"{ms / 60000:F1}m";
    }

    private static string FormatThroughput(double itemsPerSec)
    {
        if (itemsPerSec < 1) return "<1";
        if (itemsPerSec < 1000) return $"{itemsPerSec:F0}";
        return $"{itemsPerSec / 1000:F1}k";
    }

    private string FormatTimeAgo(DateTimeOffset time)
    {
        if (time == default || time == DateTimeOffset.MinValue)
            return "never";
        return GetTimeSince(time);
    }

    private void HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            NavigateToXray();
        }
    }

    private void NavigateToXray()
    {
        var url = string.IsNullOrWhiteSpace(_searchQuery)
            ? "/xray"
            : $"/xray?q={Uri.EscapeDataString(_searchQuery)}";
        Navigation.NavigateTo(url);
    }

    void IDisposable.Dispose()
    {
        _refreshTimer?.Dispose();
        StatusStore.SnapshotChanged -= OnSnapshotChanged;
        StatusStore.PipelineStatusChanged -= OnPipelineStatusChanged;
        StatusStore.StatsChanged -= OnStatsChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
