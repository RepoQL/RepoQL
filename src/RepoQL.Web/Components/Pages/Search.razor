@page "/search"
@inject SearchService SearchService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Search Testing</PageTitle>

<h1>Search Testing</h1>

<div class="search-layout">
    <section class="card params-card">
        <h2 style="margin-top: 0;">Search Parameters</h2>

        <div class="form-grid">
            <div class="form-group">
                <label for="keywords">Keywords</label>
                <input id="keywords"
                       type="text"
                       @bind="_keywords"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="How does authentication work?" />
                <span class="form-hint">Natural language questions work best for semantic search</span>
            </div>

            <div class="form-group">
                <label for="intent">Intent</label>
                <select id="intent" @bind="_intent">
                    <option value="@ExploreIntent.Inventory">Inventory - What's here?</option>
                    <option value="@ExploreIntent.Locate">Locate - Where is it?</option>
                    <option value="@ExploreIntent.Inspect">Inspect - Show details</option>
                </select>
            </div>

            <div class="form-group">
                <label for="budget">Token Budget: @_tokenBudget</label>
                <input id="budget"
                       type="range"
                       min="500"
                       max="10000"
                       step="100"
                       @bind="_tokenBudget" />
                <span class="form-hint">Higher budget = more detailed results</span>
            </div>

            <div class="form-group">
                <label for="scope">Scope (optional)</label>
                <input id="scope"
                       type="text"
                       @bind="_scope"
                       placeholder="file:///src/** or file:///docs/**" />
                <span class="form-hint">Glob pattern to filter files</span>
            </div>

            <div class="form-group">
                <label for="boost">Boost Patterns (optional)</label>
                <input id="boost"
                       type="text"
                       @bind="_boost"
                       placeholder="Auth.*,Service.*" />
                <span class="form-hint">Regex patterns to boost matching results</span>
            </div>

            <div class="form-group">
                <label for="penalize">Penalize Patterns (optional)</label>
                <input id="penalize"
                       type="text"
                       @bind="_penalize"
                       placeholder="(?i)test|mock" />
                <span class="form-hint">Regex patterns to demote matching results</span>
            </div>

            <div class="form-group">
                <label for="limit">Result Limit (optional)</label>
                <input id="limit"
                       type="number"
                       min="1"
                       max="100"
                       @bind="_limit"
                       placeholder="auto" />
            </div>
        </div>

        <div class="form-actions">
            @if (_isSearching)
            {
                <button class="btn secondary" @onclick="CancelSearch">Cancel</button>
            }
            <button class="btn primary" @onclick="ExecuteSearchAsync" disabled="@IsSearchDisabled">
                @if (_isSearching)
                {
                    <text>Searching...</text>
                }
                else
                {
                    <text>Search</text>
                }
            </button>
        </div>

        @if (_validationError is not null)
        {
            <div class="validation-error">@_validationError</div>
        }
    </section>

    <section class="card results-card">
        @if (_result is not null)
        {
            <div class="results-header">
                <h2 style="margin: 0;">Results</h2>
                <div class="status-badges">
                    @if (_result.Readiness.IsReady)
                    {
                        <span class="badge badge-ready" title="@_result.Readiness.TotalFiles files, all embedded">
                            Ready
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-partial" title="@_result.Readiness.PendingCount files pending embedding">
                            @_result.Readiness.PendingCount pending
                        </span>
                    }
                    <span class="badge badge-timing">@FormatDuration(_result.Duration)</span>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="error-callout">@_errorMessage</div>
        }
        else if (_isSearching)
        {
            <div class="loading">
                <div class="loading-spinner"></div>
                <span>Searching...</span>
            </div>
        }
        else if (_result is null)
        {
            <div class="empty-state">
                <p>Enter search parameters and click Search to test explore functionality.</p>
                <p class="hint">Results will show score breakdown to help debug ranking.</p>
            </div>
        }
        else if (_result.Hits.Count == 0)
        {
            <div class="no-results">
                <p>No results found.</p>
                @if (!_result.Readiness.IsReady)
                {
                    <p class="hint">Note: @_result.Readiness.PendingCount files are still pending embedding. Try again later for better semantic search.</p>
                }
            </div>
        }
        else
        {
            <div class="results-list">
                @foreach (var hit in _result.Hits)
                {
                    <div class="result-item">
                        <div class="result-main">
                            <div class="result-header">
                                <span class="result-uri" title="@hit.Uri">@TruncateUri(hit.Uri)</span>
                                <span class="result-score">@hit.Score.ToString("F2")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(hit.Headline))
                            {
                                <div class="result-headline">@hit.Headline</div>
                            }
                        </div>

                        <div class="score-breakdown">
                            <div class="score-row">
                                <span class="score-label">Semantic:</span>
                                <div class="score-bar-container">
                                    <div class="score-bar semantic" style="width: @((int)(hit.SemanticScore * 100))%"></div>
                                </div>
                                <span class="score-value">@hit.SemanticScore.ToString("F2")</span>
                            </div>
                            <div class="score-row">
                                <span class="score-label">BM25:</span>
                                <div class="score-bar-container">
                                    <div class="score-bar bm25" style="width: @((int)(Math.Min(hit.Bm25Score, 1) * 100))%"></div>
                                </div>
                                <span class="score-value">@hit.Bm25Score.ToString("F2")</span>
                            </div>
                        </div>

                        @if (hit.Boosted || hit.Penalized)
                        {
                            <div class="adjustments">
                                @if (hit.Boosted)
                                {
                                    <span class="adjustment boost">Boosted by: @hit.BoostReason</span>
                                }
                                @if (hit.Penalized)
                                {
                                    <span class="adjustment penalize">Penalized by: @hit.PenalizeReason</span>
                                }
                            </div>
                        }

                        <div class="result-actions">
                            <button class="btn-link" @onclick="() => NavigateToInspect(hit.Uri)">
                                Inspect
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<style>
    .search-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    @@media (max-width: 1000px) {
        .search-layout {
            grid-template-columns: 1fr;
        }
    }

    .params-card {
        position: sticky;
        top: 1rem;
    }

    .results-card {
        min-height: 400px;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .form-group label {
        font-weight: 500;
        font-size: 0.85rem;
        color: #374151;
    }

    .form-group input,
    .form-group select {
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        font-size: 0.9rem;
    }

    .form-group input[type="range"] {
        padding: 0;
        height: 8px;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #245dc1;
        box-shadow: 0 0 0 3px rgba(36, 93, 193, 0.15);
    }

    .form-hint {
        font-size: 0.75rem;
        color: #6b7280;
    }

    .form-actions {
        margin-top: 1.5rem;
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        border: none;
    }

    .btn.primary {
        background: #245dc1;
        color: white;
    }

    .btn.primary:hover:not(:disabled) {
        background: #1e4fa8;
    }

    .btn.primary:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    .btn.secondary {
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .btn.secondary:hover {
        background: #f3f4f6;
    }

    .validation-error {
        margin-top: 1rem;
        padding: 0.75rem;
        background: #fef2f2;
        border: 1px solid #fca5a5;
        border-radius: 6px;
        color: #991b1b;
        font-size: 0.9rem;
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .status-badges {
        display: flex;
        gap: 0.5rem;
    }

    .badge {
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge-ready {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-partial {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-timing {
        background: #e5e7eb;
        color: #374151;
    }

    .error-callout {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #991b1b;
        padding: 1rem;
        border-radius: 8px;
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.85rem;
    }

    .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 3rem;
        color: #64748b;
    }

    .loading-spinner {
        width: 20px;
        height: 20px;
        border: 2px solid #e5e7eb;
        border-top-color: #245dc1;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .empty-state, .no-results {
        text-align: center;
        padding: 3rem;
        color: #64748b;
    }

    .empty-state .hint, .no-results .hint {
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

    .results-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .result-item {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
        transition: border-color 0.15s;
    }

    .result-item:hover {
        border-color: #93c5fd;
    }

    .result-main {
        margin-bottom: 0.75rem;
    }

    .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .result-uri {
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.9rem;
        color: #245dc1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
        margin-right: 1rem;
    }

    .result-score {
        font-weight: 600;
        font-size: 1.1rem;
        color: #059669;
        flex-shrink: 0;
    }

    .result-headline {
        font-size: 0.9rem;
        color: #4b5563;
    }

    .score-breakdown {
        background: #f8fafc;
        border-radius: 6px;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .score-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.4rem;
    }

    .score-row:last-child {
        margin-bottom: 0;
    }

    .score-label {
        width: 70px;
        font-size: 0.8rem;
        color: #64748b;
        flex-shrink: 0;
    }

    .score-bar-container {
        flex: 1;
        height: 8px;
        background: #e5e7eb;
        border-radius: 4px;
        overflow: hidden;
    }

    .score-bar {
        height: 100%;
        border-radius: 4px;
        transition: width 0.3s ease;
    }

    .score-bar.semantic {
        background: linear-gradient(90deg, #818cf8, #6366f1);
    }

    .score-bar.bm25 {
        background: linear-gradient(90deg, #34d399, #10b981);
    }

    .score-value {
        width: 40px;
        font-size: 0.8rem;
        color: #374151;
        text-align: right;
        flex-shrink: 0;
    }

    .adjustments {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .adjustment {
        font-size: 0.8rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }

    .adjustment.boost {
        background: #dbeafe;
        color: #1e40af;
    }

    .adjustment.penalize {
        background: #fee2e2;
        color: #991b1b;
    }

    .result-actions {
        display: flex;
        justify-content: flex-end;
    }

    .btn-link {
        background: none;
        border: none;
        color: #245dc1;
        cursor: pointer;
        font-size: 0.9rem;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }

    .btn-link:hover {
        background: #eff6ff;
        text-decoration: underline;
    }
</style>

@code {
    private string _keywords = "";
    private ExploreIntent _intent = ExploreIntent.Locate;
    private int _tokenBudget = 2000;
    private string? _scope;
    private string? _boost;
    private string? _penalize;
    private int? _limit;

    private bool _isSearching;
    private SearchResult? _result;
    private string? _errorMessage;
    private string? _validationError;
    private CancellationTokenSource? _searchCts;

    private bool IsSearchDisabled =>
        _isSearching ||
        (RequiresKeywords && string.IsNullOrWhiteSpace(_keywords));

    private bool RequiresKeywords =>
        _intent is ExploreIntent.Locate or ExploreIntent.Inspect;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter")
        {
            await ExecuteSearchAsync();
        }
    }

    private async Task ExecuteSearchAsync()
    {
        if (IsSearchDisabled)
            return;

        // Validate
        _validationError = null;
        if (RequiresKeywords && string.IsNullOrWhiteSpace(_keywords))
        {
            _validationError = "Keywords are required for this intent.";
            return;
        }

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();

        _isSearching = true;
        _errorMessage = null;
        _result = null;
        StateHasChanged();

        try
        {
            var @params = new SearchParams(
                Keywords: _keywords,
                Intent: _intent,
                TokenBudget: _tokenBudget,
                Scope: string.IsNullOrWhiteSpace(_scope) ? null : _scope,
                Boost: string.IsNullOrWhiteSpace(_boost) ? null : _boost,
                Penalize: string.IsNullOrWhiteSpace(_penalize) ? null : _penalize,
                Limit: _limit > 0 ? _limit : null);

            _result = await SearchService.SearchAsync(@params, _searchCts.Token);

            if (_result.Error is not null)
            {
                _errorMessage = _result.Error;
            }
        }
        catch (OperationCanceledException)
        {
            // Ignored
        }
        catch (Exception ex)
        {
            _errorMessage = ex.GetBaseException().Message;
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private void CancelSearch()
    {
        _searchCts?.Cancel();
    }

    private void NavigateToInspect(string uri)
    {
        var encodedUri = Uri.EscapeDataString(uri);
        NavigationManager.NavigateTo($"/inspect?uri={encodedUri}");
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMilliseconds < 1)
            return "<1ms";
        if (duration.TotalMilliseconds < 1000)
            return $"{duration.TotalMilliseconds:F0}ms";
        return $"{duration.TotalSeconds:F2}s";
    }

    private static string TruncateUri(string uri)
    {
        if (uri.Length <= 70)
            return uri;
        return uri[..35] + "..." + uri[^30..];
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
