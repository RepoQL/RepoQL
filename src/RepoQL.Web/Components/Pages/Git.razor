@page "/git"
@page "/git/{SubView}"
@inject GitService GitService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Git - @GetSubViewTitle()</PageTitle>

<h1>Git</h1>

<!-- Sub-view Navigation -->
<div class="subview-nav">
    <button class="subview-tab @(CurrentSubView == "hotspots" ? "active" : "")"
            @onclick='() => Navigate("hotspots")'>
        Hotspots
    </button>
    <button class="subview-tab @(CurrentSubView == "blame" ? "active" : "")"
            @onclick='() => Navigate("blame")'>
        Blame
    </button>
    <button class="subview-tab @(CurrentSubView == "history" ? "active" : "")"
            @onclick='() => Navigate("history")'>
        History
    </button>
    <button class="subview-tab @(CurrentSubView == "related" ? "active" : "")"
            @onclick='() => Navigate("related")'>
        Related
    </button>
</div>

<div class="git-content">
    @if (CurrentSubView == "hotspots")
    {
        <!-- Hotspots View -->
        @if (_isLoading)
        {
            <div class="loading">Loading hotspots...</div>
        }
        else if (_hotspots.Count == 0)
        {
            <div class="empty-state">No git history available.</div>
        }
        else
        {
            <div class="hotspots-list">
                <div class="list-header">
                    <span class="col-uri">File</span>
                    <span class="col-commits">Commits</span>
                    <span class="col-authors">Authors</span>
                    <span class="col-churn">Churn</span>
                    <span class="col-date">Last Changed</span>
                </div>
                @foreach (var item in _hotspots)
                {
                    <div class="hotspot-item">
                        <button class="col-uri uri-link" @onclick="() => NavigateToInspect(item.Uri)">
                            @TruncateUri(item.Uri)
                        </button>
                        <span class="col-commits">@item.CommitCount</span>
                        <span class="col-authors">@item.AuthorCount</span>
                        <span class="col-churn">
                            <span class="churn-bar" style="width: @GetChurnWidth(item.Churn)"></span>
                            @item.Churn
                        </span>
                        <span class="col-date">@FormatDate(item.LastChanged)</span>
                    </div>
                }
            </div>
        }
    }
    else if (CurrentSubView == "blame")
    {
        <!-- Blame View -->
        <div class="uri-input-section">
            <input type="text"
                   class="uri-input"
                   placeholder="Enter file URI (e.g., file:///src/App.cs)"
                   @bind="_blameUri"
                   @bind:event="oninput"
                   @onkeydown="HandleBlameKeyDown" />
            <button class="btn primary" @onclick="LoadBlameAsync" disabled="@(_isLoading || string.IsNullOrWhiteSpace(_blameUri))">
                @(_isLoading ? "Loading..." : "Load Blame")
            </button>
        </div>

        @if (_blameLines.Count > 0)
        {
            <div class="blame-list">
                @{
                    string? lastCommit = null;
                    int groupIndex = 0;
                }
                @foreach (var line in _blameLines)
                {
                    if (line.CommitHash != lastCommit)
                    {
                        lastCommit = line.CommitHash;
                        groupIndex++;
                    }
                    <div class="blame-line @(groupIndex % 2 == 0 ? "even" : "odd")">
                        <span class="line-number">@line.LineNumber</span>
                        <span class="line-author" title="@line.Message">@TruncateAuthor(line.Author)</span>
                        <span class="line-date">@FormatRelativeDate(line.Date)</span>
                        <span class="line-content">@line.Content</span>
                    </div>
                }
            </div>
        }
        else if (!_isLoading && !string.IsNullOrWhiteSpace(_blameUri))
        {
            <div class="empty-state">No blame data available. The file may not be tracked by git.</div>
        }
    }
    else if (CurrentSubView == "history")
    {
        <!-- History View -->
        <div class="uri-input-section">
            <input type="text"
                   class="uri-input"
                   placeholder="Enter file URI (e.g., file:///src/App.cs)"
                   @bind="_historyUri"
                   @bind:event="oninput"
                   @onkeydown="HandleHistoryKeyDown" />
            <input type="text"
                   class="filter-input"
                   placeholder="Filter by message/author"
                   @bind="_historyFilter"
                   @bind:event="oninput" />
            <button class="btn primary" @onclick="LoadHistoryAsync" disabled="@(_isLoading || string.IsNullOrWhiteSpace(_historyUri))">
                @(_isLoading ? "Loading..." : "Load History")
            </button>
        </div>

        @if (_historyCommits.Count > 0)
        {
            <div class="history-list">
                @foreach (var commit in _historyCommits)
                {
                    <div class="commit-item">
                        <div class="commit-header">
                            <span class="commit-hash" title="@commit.Hash">@commit.Hash[..7]</span>
                            <span class="commit-author">@commit.Author</span>
                            <span class="commit-date">@FormatDate(commit.Date)</span>
                            <span class="commit-changes">
                                <span class="insertions">+@commit.Insertions</span>
                                <span class="deletions">-@commit.Deletions</span>
                            </span>
                        </div>
                        <div class="commit-message">@TruncateMessage(commit.Message)</div>
                    </div>
                }
            </div>
        }
        else if (!_isLoading && !string.IsNullOrWhiteSpace(_historyUri))
        {
            <div class="empty-state">No history available. The file may not be tracked by git.</div>
        }
    }
    else if (CurrentSubView == "related")
    {
        <!-- Related Commits View -->
        <div class="uri-input-section">
            <input type="text"
                   class="uri-input wide"
                   placeholder="Enter search terms (e.g., authentication, error handling)"
                   @bind="_relatedQuery"
                   @bind:event="oninput"
                   @onkeydown="HandleRelatedKeyDown" />
            <button class="btn primary" @onclick="LoadRelatedAsync" disabled="@(_isLoading || string.IsNullOrWhiteSpace(_relatedQuery))">
                @(_isLoading ? "Searching..." : "Find Related")
            </button>
        </div>

        @if (_relatedCommits.Count > 0)
        {
            <div class="related-list">
                @foreach (var commit in _relatedCommits)
                {
                    <div class="commit-item">
                        <div class="commit-header">
                            <span class="commit-hash">@commit.Hash[..7]</span>
                            <span class="commit-author">@commit.Author</span>
                            <span class="commit-date">@commit.Date</span>
                            <span class="commit-files">@commit.FilesChanged files, @commit.RelatedFiles related</span>
                        </div>
                        <div class="commit-message">@TruncateMessage(commit.Message)</div>
                    </div>
                }
            </div>
        }
        else if (!_isLoading && !string.IsNullOrWhiteSpace(_relatedQuery))
        {
            <div class="empty-state">No related commits found.</div>
        }
    }
</div>

<style>
    .subview-nav {
        display: flex;
        gap: 0.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 0.5rem;
    }

    .subview-tab {
        padding: 0.6rem 1rem;
        border: none;
        background: none;
        cursor: pointer;
        font-size: 0.95rem;
        color: #64748b;
        border-radius: 6px 6px 0 0;
        transition: all 0.15s;
    }

    .subview-tab:hover {
        color: #1f2937;
        background: #f3f4f6;
    }

    .subview-tab.active {
        color: #245dc1;
        background: #eff6ff;
        font-weight: 500;
    }

    .git-content {
        min-height: 400px;
    }

    .loading, .empty-state {
        text-align: center;
        padding: 3rem;
        color: #64748b;
    }

    .uri-input-section {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .uri-input {
        flex: 1;
        min-width: 300px;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.9rem;
    }

    .uri-input.wide {
        min-width: 400px;
    }

    .filter-input {
        width: 200px;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .uri-input:focus, .filter-input:focus {
        outline: none;
        border-color: #245dc1;
        box-shadow: 0 0 0 3px rgba(36, 93, 193, 0.15);
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        border: none;
    }

    .btn.primary {
        background: #245dc1;
        color: white;
    }

    .btn.primary:hover:not(:disabled) {
        background: #1e4fa8;
    }

    .btn.primary:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    /* Hotspots */
    .hotspots-list {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .list-header {
        display: flex;
        padding: 0.75rem 1rem;
        background: #f8fafc;
        font-weight: 600;
        font-size: 0.85rem;
        color: #64748b;
        border-bottom: 1px solid #e5e7eb;
    }

    .hotspot-item {
        display: flex;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f3f4f6;
        align-items: center;
    }

    .hotspot-item:last-child {
        border-bottom: none;
    }

    .hotspot-item:hover {
        background: #f8fafc;
    }

    .col-uri { flex: 1; min-width: 200px; }
    .col-commits { width: 80px; text-align: center; }
    .col-authors { width: 80px; text-align: center; }
    .col-churn { width: 100px; display: flex; align-items: center; gap: 0.5rem; }
    .col-date { width: 120px; text-align: right; color: #64748b; font-size: 0.85rem; }

    .uri-link {
        background: none;
        border: none;
        color: #245dc1;
        cursor: pointer;
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.9rem;
        text-align: left;
        padding: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .uri-link:hover {
        text-decoration: underline;
    }

    .churn-bar {
        height: 8px;
        background: linear-gradient(90deg, #fde68a, #f59e0b);
        border-radius: 4px;
        min-width: 4px;
    }

    /* Blame */
    .blame-list {
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.85rem;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: auto;
        max-height: 70vh;
    }

    .blame-line {
        display: flex;
        padding: 0.15rem 0.5rem;
        border-bottom: 1px solid #f3f4f6;
    }

    .blame-line.even {
        background: #f8fafc;
    }

    .blame-line.odd {
        background: white;
    }

    .line-number {
        width: 50px;
        color: #94a3b8;
        text-align: right;
        padding-right: 0.75rem;
        flex-shrink: 0;
    }

    .line-author {
        width: 80px;
        color: #6366f1;
        flex-shrink: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .line-date {
        width: 50px;
        color: #64748b;
        flex-shrink: 0;
        font-size: 0.8rem;
    }

    .line-content {
        flex: 1;
        white-space: pre;
        overflow-x: auto;
    }

    /* History and Related */
    .history-list, .related-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .commit-item {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
    }

    .commit-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .commit-hash {
        font-family: ui-monospace, SFMono-Regular, monospace;
        color: #6366f1;
        font-weight: 500;
    }

    .commit-author {
        color: #374151;
    }

    .commit-date {
        color: #64748b;
        font-size: 0.85rem;
    }

    .commit-changes {
        display: flex;
        gap: 0.5rem;
        font-size: 0.85rem;
    }

    .insertions { color: #22c55e; }
    .deletions { color: #ef4444; }

    .commit-files {
        color: #64748b;
        font-size: 0.85rem;
    }

    .commit-message {
        color: #4b5563;
        font-size: 0.9rem;
    }

    @@media (max-width: 768px) {
        .list-header {
            display: none;
        }

        .hotspot-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .col-uri, .col-commits, .col-authors, .col-churn, .col-date {
            width: auto;
        }
    }
</style>

@code {
    [Parameter]
    public string? SubView { get; set; }

    [SupplyParameterFromQuery(Name = "uri")]
    public string? InitialUri { get; set; }

    private string CurrentSubView => string.IsNullOrEmpty(SubView) ? "hotspots" : SubView.ToLowerInvariant();

    // Hotspots
    private IReadOnlyList<HotspotInfo> _hotspots = [];
    private int _maxChurn = 1;

    // Blame
    private string _blameUri = "";
    private IReadOnlyList<BlameLine> _blameLines = [];

    // History
    private string _historyUri = "";
    private string _historyFilter = "";
    private IReadOnlyList<CommitInfo> _historyCommits = [];

    // Related
    private string _relatedQuery = "";
    private IReadOnlyList<RelatedCommit> _relatedCommits = [];

    private bool _isLoading;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentSubView == "hotspots" && _hotspots.Count == 0)
        {
            await LoadHotspotsAsync();
        }
        else if (!string.IsNullOrEmpty(InitialUri))
        {
            // Handle URI passed from Inspect view
            if (CurrentSubView == "blame" && _blameUri != InitialUri)
            {
                _blameUri = InitialUri;
                await LoadBlameAsync();
            }
            else if (CurrentSubView == "history" && _historyUri != InitialUri)
            {
                _historyUri = InitialUri;
                await LoadHistoryAsync();
            }
        }
    }

    private void Navigate(string subView)
    {
        NavigationManager.NavigateTo($"/git/{subView}");
    }

    private string GetSubViewTitle() => CurrentSubView switch
    {
        "blame" => "Blame",
        "history" => "History",
        "related" => "Related Commits",
        _ => "Hotspots"
    };

    private async Task LoadHotspotsAsync()
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();

        _isLoading = true;
        StateHasChanged();

        try
        {
            _hotspots = await GitService.GetHotspotsAsync(ct: _loadCts.Token);
            _maxChurn = _hotspots.Count > 0 ? _hotspots.Max(h => h.Churn) : 1;
            if (_maxChurn == 0) _maxChurn = 1;
        }
        catch (OperationCanceledException) { }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleBlameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadBlameAsync();
    }

    private async Task LoadBlameAsync()
    {
        if (string.IsNullOrWhiteSpace(_blameUri)) return;

        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();

        _isLoading = true;
        _blameLines = [];
        StateHasChanged();

        try
        {
            _blameLines = await GitService.GetBlameAsync(_blameUri.Trim(), _loadCts.Token);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleHistoryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_historyUri)) return;

        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();

        _isLoading = true;
        _historyCommits = [];
        StateHasChanged();

        try
        {
            _historyCommits = await GitService.GetHistoryAsync(
                _historyUri.Trim(),
                string.IsNullOrWhiteSpace(_historyFilter) ? null : _historyFilter,
                ct: _loadCts.Token);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRelatedKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadRelatedAsync();
    }

    private async Task LoadRelatedAsync()
    {
        if (string.IsNullOrWhiteSpace(_relatedQuery)) return;

        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();

        _isLoading = true;
        _relatedCommits = [];
        StateHasChanged();

        try
        {
            _relatedCommits = await GitService.GetRelatedCommitsAsync(_relatedQuery.Trim(), ct: _loadCts.Token);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToInspect(string uri)
    {
        var encodedUri = Uri.EscapeDataString(uri);
        NavigationManager.NavigateTo($"/inspect?uri={encodedUri}");
    }

    private string GetChurnWidth(int churn)
    {
        var percent = (churn * 100) / _maxChurn;
        return $"{Math.Max(percent, 5)}%";
    }

    private static string TruncateUri(string uri)
    {
        // Remove file:/// prefix for display
        if (uri.StartsWith("file:///", StringComparison.OrdinalIgnoreCase))
            uri = uri["file:///".Length..];
        if (uri.Length <= 60) return uri;
        return "..." + uri[^55..];
    }

    private static string TruncateAuthor(string author)
    {
        if (author.Length <= 10) return author;
        return author[..8] + "..";
    }

    private static string TruncateMessage(string message)
    {
        var firstLine = message.Split('\n')[0].Trim();
        if (firstLine.Length <= 100) return firstLine;
        return firstLine[..97] + "...";
    }

    private static string FormatDate(DateTime? dt)
    {
        if (!dt.HasValue) return "";
        var ago = DateTime.UtcNow - dt.Value;
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        if (ago.TotalDays < 30) return $"{(int)ago.TotalDays}d ago";
        return dt.Value.ToString("MMM d, yyyy");
    }

    private static string FormatRelativeDate(DateTime? dt)
    {
        if (!dt.HasValue) return "";
        var ago = DateTime.UtcNow - dt.Value;
        if (ago.TotalDays < 1) return "now";
        if (ago.TotalDays < 7) return $"{(int)ago.TotalDays}d";
        if (ago.TotalDays < 30) return $"{(int)(ago.TotalDays / 7)}w";
        if (ago.TotalDays < 365) return $"{(int)(ago.TotalDays / 30)}mo";
        return $"{(int)(ago.TotalDays / 365)}y";
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
