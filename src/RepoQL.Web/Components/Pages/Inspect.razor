@page "/inspect"
@inject InspectService InspectService
@inject INavigationState NavigationState
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Inspect - @(_result?.Metadata?.Uri ?? "File")</PageTitle>

<div class="inspect-header">
    <div class="header-left">
        @if (NavigationState.CanGoBack)
        {
            <button class="btn-back" @onclick="GoBack" title="Go back (Alt+Left)">
                &lt; Back
            </button>
        }
        <h1>Inspect</h1>
    </div>
    <div class="uri-input-group">
        <input type="text"
               class="uri-input"
               placeholder="Enter file URI (e.g., file:///src/App.cs)"
               @bind="_uriInput"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown" />
        <button class="btn primary" @onclick="LoadFromInput" disabled="@_isLoading">
            @(_isLoading ? "Loading..." : "Inspect")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="error-callout">@_errorMessage</div>
}
else if (_isLoading)
{
    <div class="loading-state">Loading file information...</div>
}
else if (_result?.Metadata is null)
{
    <div class="empty-state">
        <p>Enter a file URI above to inspect it, or navigate here from Search results.</p>
        <p class="hint">File not in index? It may be in .gitignore or not yet indexed.</p>
    </div>
}
else
{
    var meta = _result.Metadata;

    <!-- File Metadata Section -->
    <section class="card metadata-section">
        <div class="file-header">
            <h2 class="file-uri">@meta.Uri</h2>
            <div class="git-actions">
                <button class="btn-git" @onclick="() => NavigateToBlame(meta.Uri)" title="View blame for this file">
                    Blame
                </button>
                <button class="btn-git" @onclick="() => NavigateToHistory(meta.Uri)" title="View history for this file">
                    History
                </button>
            </div>
        </div>
        <div class="meta-grid">
            <div class="meta-item">
                <span class="meta-label">Language</span>
                <span class="meta-value">@meta.Language</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Lines</span>
                <span class="meta-value">@meta.Lines</span>
            </div>
            <div class="meta-item">
                <span class="meta-label">Embeddings</span>
                <span class="meta-value @(meta.HasEmbeddings ? "ready" : "pending")">
                    @(meta.HasEmbeddings ? "Ready" : "Pending")
                </span>
            </div>
            @if (meta.ErrorCount > 0 || meta.WarningCount > 0)
            {
                <div class="meta-item">
                    <span class="meta-label">Issues</span>
                    <span class="meta-value">
                        @if (meta.ErrorCount > 0)
                        {
                            <span class="badge error">@meta.ErrorCount errors</span>
                        }
                        @if (meta.WarningCount > 0)
                        {
                            <span class="badge warning">@meta.WarningCount warnings</span>
                        }
                    </span>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(meta.Headline))
        {
            <div class="headline">@meta.Headline</div>
        }

        @if (!string.IsNullOrWhiteSpace(meta.Structure))
        {
            <details class="structure-details">
                <summary>Structure</summary>
                <pre class="structure-pre">@meta.Structure</pre>
            </details>
        }
    </section>

    <!-- Nodes Section -->
    <section class="card nodes-section">
        <h3>Nodes (@_result.Nodes.Count)</h3>
        @if (_result.Nodes.Count == 0)
        {
            <p class="no-data">No structure extracted</p>
        }
        else
        {
            <div class="nodes-grid">
                @foreach (var group in _result.Nodes.GroupBy(n => n.Kind))
                {
                    <div class="node-group">
                        <h4>@FormatKind(group.Key) (@group.Count())</h4>
                        <ul class="node-list">
                            @foreach (var node in group.Take(10))
                            {
                                <li>
                                    <span class="node-name">@node.Name</span>
                                    @if (node.StartLine.HasValue)
                                    {
                                        <span class="node-lines">[@node.StartLine-@node.EndLine]</span>
                                    }
                                </li>
                            }
                            @if (group.Count() > 10)
                            {
                                <li class="more">+@(group.Count() - 10) more</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Edges Section -->
    <section class="card edges-section">
        <h3>Edges</h3>
        <div class="edges-grid">
            <div class="edge-column">
                <h4>Outgoing (@_result.OutgoingEdges.Count)</h4>
                @if (_result.OutgoingEdges.Count == 0)
                {
                    <p class="no-data">No outgoing edges</p>
                }
                else
                {
                    <ul class="edge-list">
                        @foreach (var edge in _result.OutgoingEdges.Take(20))
                        {
                            <li>
                                <button class="edge-link" @onclick="() => NavigateToEdge(edge.TargetUri)">
                                    <span class="edge-type">@edge.Type</span>
                                    <span class="edge-target">@TruncateUri(edge.TargetUri)</span>
                                    @if (edge.SourceLine.HasValue)
                                    {
                                        <span class="edge-line">:@edge.SourceLine</span>
                                    }
                                </button>
                            </li>
                        }
                        @if (_result.OutgoingEdges.Count > 20)
                        {
                            <li class="more">+@(_result.OutgoingEdges.Count - 20) more</li>
                        }
                    </ul>
                }
            </div>

            <div class="edge-column">
                <h4>Incoming (@_result.IncomingEdges.Count)</h4>
                @if (_result.IncomingEdges.Count == 0)
                {
                    <p class="no-data">No incoming edges</p>
                }
                else
                {
                    <ul class="edge-list">
                        @foreach (var edge in _result.IncomingEdges.Take(20))
                        {
                            <li>
                                <button class="edge-link" @onclick="() => NavigateToEdge(edge.TargetUri)">
                                    <span class="edge-type">@edge.Type</span>
                                    <span class="edge-target">@TruncateUri(edge.TargetUri)</span>
                                </button>
                            </li>
                        }
                        @if (_result.IncomingEdges.Count > 20)
                        {
                            <li class="more">+@(_result.IncomingEdges.Count - 20) more</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>

    <!-- Annotations Section -->
    @if (_result.Annotations.Count > 0)
    {
        <section class="card annotations-section">
            <h3>Annotations (@_result.Annotations.Count)</h3>
            <ul class="annotation-list">
                @foreach (var ann in _result.Annotations)
                {
                    <li class="annotation @ann.Severity">
                        <span class="ann-icon">@GetSeverityIcon(ann.Severity)</span>
                        <span class="ann-rule">@ann.RuleId</span>
                        <span class="ann-message">@ann.Message</span>
                        @if (ann.Line.HasValue)
                        {
                            <span class="ann-line">:@ann.Line</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}

<style>
    .inspect-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .file-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .git-actions {
        display: flex;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .btn-git {
        padding: 0.4rem 0.75rem;
        background: #f8fafc;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 500;
        color: #374151;
        transition: all 0.15s;
    }

    .btn-git:hover {
        background: #eff6ff;
        border-color: #93c5fd;
        color: #245dc1;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .header-left h1 {
        margin: 0;
    }

    .btn-back {
        padding: 0.4rem 0.75rem;
        background: white;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
        color: #374151;
    }

    .btn-back:hover {
        background: #f3f4f6;
    }

    .uri-input-group {
        display: flex;
        gap: 0.5rem;
        flex: 1;
        max-width: 600px;
    }

    .uri-input {
        flex: 1;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.9rem;
    }

    .uri-input:focus {
        outline: none;
        border-color: #245dc1;
        box-shadow: 0 0 0 3px rgba(36, 93, 193, 0.15);
    }

    .metadata-section {
        margin-bottom: 1.5rem;
    }

    .file-uri {
        font-size: 1.1rem;
        font-family: ui-monospace, SFMono-Regular, monospace;
        word-break: break-all;
        margin: 0;
        color: #1f2937;
        flex: 1;
    }

    .meta-grid {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .meta-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .meta-label {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .meta-value {
        font-weight: 600;
        color: #1f2937;
    }

    .meta-value.ready {
        color: #22c55e;
    }

    .meta-value.pending {
        color: #f59e0b;
    }

    .badge {
        display: inline-block;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge.error {
        background: #fef2f2;
        color: #991b1b;
    }

    .badge.warning {
        background: #fefce8;
        color: #92400e;
    }

    .headline {
        font-size: 1rem;
        color: #4b5563;
        padding: 0.75rem;
        background: #f8fafc;
        border-radius: 6px;
        margin-top: 1rem;
    }

    .structure-details {
        margin-top: 1rem;
    }

    .structure-details summary {
        cursor: pointer;
        font-weight: 500;
        padding: 0.5rem 0;
    }

    .structure-pre {
        background: #f8fafc;
        padding: 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        overflow-x: auto;
        margin: 0.5rem 0 0 0;
    }

    .nodes-section, .edges-section, .annotations-section {
        margin-bottom: 1.5rem;
    }

    .nodes-section h3, .edges-section h3, .annotations-section h3 {
        margin-top: 0;
        margin-bottom: 1rem;
    }

    .nodes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .node-group h4 {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
        color: #64748b;
    }

    .node-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .node-list li {
        padding: 0.35rem 0;
        font-size: 0.9rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .node-name {
        font-family: ui-monospace, SFMono-Regular, monospace;
    }

    .node-lines {
        color: #64748b;
        font-size: 0.8rem;
        margin-left: 0.5rem;
    }

    .edges-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    .edge-column h4 {
        margin: 0 0 0.75rem 0;
        font-size: 0.9rem;
        color: #64748b;
    }

    .edge-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .edge-list li {
        margin-bottom: 0.25rem;
    }

    .edge-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.4rem 0.5rem;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        cursor: pointer;
        text-align: left;
        font-size: 0.85rem;
        transition: background 0.15s;
    }

    .edge-link:hover {
        background: #eff6ff;
        border-color: #93c5fd;
    }

    .edge-type {
        background: #e0e7ff;
        color: #4338ca;
        padding: 0.1rem 0.35rem;
        border-radius: 3px;
        font-size: 0.75rem;
        font-weight: 500;
        flex-shrink: 0;
    }

    .edge-target {
        font-family: ui-monospace, SFMono-Regular, monospace;
        color: #245dc1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .edge-line {
        color: #64748b;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .annotation-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .annotation {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.5rem;
        border-radius: 6px;
        margin-bottom: 0.35rem;
        font-size: 0.9rem;
    }

    .annotation.error {
        background: #fef2f2;
    }

    .annotation.warning {
        background: #fefce8;
    }

    .annotation.info {
        background: #eff6ff;
    }

    .ann-icon {
        flex-shrink: 0;
        width: 1.25rem;
        text-align: center;
    }

    .ann-rule {
        flex-shrink: 0;
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.8rem;
        color: #64748b;
    }

    .ann-message {
        flex: 1;
    }

    .ann-line {
        flex-shrink: 0;
        color: #64748b;
        font-size: 0.85rem;
    }

    .no-data, .more {
        color: #64748b;
        font-style: italic;
        font-size: 0.9rem;
    }

    .loading-state, .empty-state {
        text-align: center;
        padding: 3rem;
        color: #64748b;
    }

    .empty-state .hint {
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

    .error-callout {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #991b1b;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .edges-grid {
            grid-template-columns: 1fr;
        }

        .uri-input-group {
            max-width: 100%;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "uri")]
    public string? InitialUri { get; set; }

    private string _uriInput = "";
    private string? _currentUri;
    private InspectResult? _result;
    private string? _errorMessage;
    private bool _isLoading;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        NavigationState.OnChange += OnNavigationChanged;

        if (!string.IsNullOrEmpty(InitialUri))
        {
            _uriInput = InitialUri;
            await LoadAsync(InitialUri);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(InitialUri) && InitialUri != _currentUri)
        {
            _uriInput = InitialUri;
            await LoadAsync(InitialUri);
        }
    }

    private void OnNavigationChanged()
    {
        // Handle back navigation - reload if URI changed
        var entry = NavigationState.Current;
        if (entry.View == "inspect" && entry.Params?.Uri is not null && entry.Params.Uri != _currentUri)
        {
            _uriInput = entry.Params.Uri;
            _ = InvokeAsync(async () =>
            {
                await LoadAsync(entry.Params.Uri);
                StateHasChanged();
            });
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadFromInput();
        }
    }

    private async Task LoadFromInput()
    {
        if (string.IsNullOrWhiteSpace(_uriInput))
            return;

        // Update navigation state
        NavigationState.NavigateTo("inspect", new NavigationParams(Uri: _uriInput));

        // Update URL
        var encodedUri = Uri.EscapeDataString(_uriInput);
        NavigationManager.NavigateTo($"/inspect?uri={encodedUri}", replace: true);

        await LoadAsync(_uriInput);
    }

    private async Task LoadAsync(string uri)
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();

        _isLoading = true;
        _errorMessage = null;
        _result = null;
        _currentUri = uri;
        StateHasChanged();

        try
        {
            _result = await InspectService.InspectAsync(uri, _loadCts.Token);

            if (_result.Metadata is null)
            {
                _errorMessage = $"File not found in index: {uri}";
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore
        }
        catch (Exception ex)
        {
            _errorMessage = ex.GetBaseException().Message;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToEdge(string targetUri)
    {
        // Push current to history, navigate to target
        NavigationState.NavigateTo("inspect", new NavigationParams(Uri: targetUri));

        _uriInput = targetUri;
        var encodedUri = Uri.EscapeDataString(targetUri);
        NavigationManager.NavigateTo($"/inspect?uri={encodedUri}");
    }

    private void GoBack()
    {
        NavigationState.GoBack();
        var entry = NavigationState.Current;

        if (entry.Params?.Uri is not null)
        {
            _uriInput = entry.Params.Uri;
            var encodedUri = Uri.EscapeDataString(entry.Params.Uri);
            NavigationManager.NavigateTo($"/inspect?uri={encodedUri}");
        }
        else
        {
            NavigationManager.NavigateTo($"/{entry.View}");
        }
    }

    private void NavigateToBlame(string uri)
    {
        var encodedUri = Uri.EscapeDataString(uri);
        NavigationManager.NavigateTo($"/git/blame?uri={encodedUri}");
    }

    private void NavigateToHistory(string uri)
    {
        var encodedUri = Uri.EscapeDataString(uri);
        NavigationManager.NavigateTo($"/git/history?uri={encodedUri}");
    }

    private static string FormatKind(string kind) => kind switch
    {
        "class" => "Classes",
        "interface" => "Interfaces",
        "struct" => "Structs",
        "enum" => "Enums",
        "function" => "Functions",
        "method" => "Methods",
        "property" => "Properties",
        _ => kind
    };

    private static string TruncateUri(string uri)
    {
        if (uri.Length <= 60)
            return uri;

        // Show start and end
        return uri[..30] + "..." + uri[^25..];
    }

    private static string GetSeverityIcon(string severity) => severity switch
    {
        "error" => "X",
        "warning" => "!",
        "info" => "i",
        _ => "?"
    };

    public void Dispose()
    {
        NavigationState.OnChange -= OnNavigationChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
