@page "/xray"
@inject XrayService XrayService
@implements IDisposable

<PageTitle>Xray Search</PageTitle>

<h1>Xray Search</h1>

<div class="xray-layout">
    <section class="card query-card">
        <h2 style="margin-top: 0;">Query Parameters</h2>

        <div class="form-grid">
            <div class="form-group">
                <label for="token-budget">Token Budget</label>
                <input id="token-budget" type="number" min="100" max="10000" @bind="_tokenBudget" />
                <span class="form-hint">Investment level - more tokens = richer detail</span>
            </div>

            <div class="form-group">
                <label for="intent">Intent</label>
                <select id="intent" @bind="_intent">
                    <option value="@XrayIntent.Explore">Explore - What's here? (headlines)</option>
                    <option value="@XrayIntent.Find">Find - Where is it? (broad context)</option>
                    <option value="@XrayIntent.Examine">Examine - Show me the code (detailed snippets)</option>
                    <option value="@XrayIntent.Understand">Understand - Synthesize via LLM (requires keywords)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="keywords">Keywords</label>
                <input id="keywords" type="text" @bind="_keywords" placeholder="How does authentication work?" />
                <span class="form-hint">Natural language questions work best for semantic search</span>
            </div>

            <div class="form-group">
                <label for="scope">Scope</label>
                <input id="scope" type="text" @bind="_scope" placeholder="file:///src/** or repoql-docs://**" />
                <span class="form-hint">Glob pattern or URI to filter results</span>
            </div>

            <div class="form-group">
                <label for="boost">Boost Patterns</label>
                <input id="boost" type="text" @bind="_boost" placeholder="Auth.*,Token.*" />
                <span class="form-hint">Comma-separated regex to boost matches</span>
            </div>

            <div class="form-group">
                <label for="penalize">Penalize Patterns</label>
                <input id="penalize" type="text" @bind="_penalize" placeholder="(?i)test|mock" />
                <span class="form-hint">Comma-separated regex to de-rank matches</span>
            </div>

            <div class="form-group">
                <label for="limit">Result Limit</label>
                <input id="limit" type="number" min="0" @bind="_limit" placeholder="auto" />
                <span class="form-hint">Max results (0 = auto-calculate)</span>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn primary" @onclick="ExecuteAsync" disabled="@_isExecuting">
                @if (_isExecuting)
                {
                    <text>Searching...</text>
                }
                else
                {
                    <text>Search</text>
                }
            </button>
        </div>
    </section>

    <section class="card results-card">
        @if (_result is not null)
        {
            <div class="results-header">
                <h2 style="margin: 0;">Results</h2>
                @if (_result.Status is not null)
                {
                    <div class="status-badges">
                        @if (_result.Status.Ready)
                        {
                            <span class="badge badge-online">Ready</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">
                                @if (_result.Status.IndexPending > 0)
                                {
                                    <text>@_result.Status.IndexPending pending</text>
                                }
                                else if (!_result.Status.SemanticReady)
                                {
                                    <text>Embeddings not ready</text>
                                }
                            </span>
                        }
                        <span class="badge badge-neutral">@_result.Status.ElapsedMs ms</span>
                        @if (_result.Truncated)
                        {
                            <span class="badge badge-warning">Truncated</span>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="error-callout">@_errorMessage</div>
        }
        else if (_isExecuting)
        {
            <div class="loading">Executing xray query...</div>
        }
        else if (_result is null)
        {
            <p class="placeholder-text">Enter query parameters and click Search to explore your codebase.</p>
        }
        else if (!_result.Success)
        {
            <div class="error-callout">@(_result.Error ?? "Unknown error")</div>
        }
        else
        {
            <div class="view-toggle">
                <button class="@(_showRendered ? "active" : "")" @onclick="() => _showRendered = true">Rendered</button>
                <button class="@(!_showRendered ? "active" : "")" @onclick="() => _showRendered = false">Structured (@_result.Results.Count)</button>
            </div>

            @if (_showRendered)
            {
                <div class="rendered-output">
                    <pre>@_result.RenderedOutput</pre>
                </div>
            }
            else
            {
                <div class="structured-results">
                    @foreach (var item in _result.Results)
                    {
                        <div class="result-item">
                            <div class="result-header">
                                <span class="result-uri" title="@item.Uri">@TruncateUri(item.Uri)</span>
                                <span class="result-confidence">@item.Confidence%</span>
                                @if (!string.IsNullOrEmpty(item.Kind))
                                {
                                    <span class="result-kind">@item.Kind</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Headline))
                            {
                                <div class="result-headline">@item.Headline</div>
                            }
                            @if (!string.IsNullOrEmpty(item.Structure))
                            {
                                <details class="result-structure">
                                    <summary>Structure</summary>
                                    <pre>@item.Structure</pre>
                                </details>
                            }
                            @if (!string.IsNullOrEmpty(item.Snippet))
                            {
                                <details class="result-snippet">
                                    <summary>Snippet</summary>
                                    <pre><code class="@($"language-{item.Lang ?? "text"}")">@item.Snippet</code></pre>
                                </details>
                            }
                            @if (item.Children is { Count: > 0 })
                            {
                                <details class="result-children">
                                    <summary>@item.Children.Count child objects</summary>
                                    @foreach (var child in item.Children)
                                    {
                                        <div class="child-item">
                                            <span class="child-uri">@TruncateUri(child.Uri)</span>
                                            @if (!string.IsNullOrEmpty(child.Kind))
                                            {
                                                <span class="child-kind">@child.Kind</span>
                                            }
                                            @if (!string.IsNullOrEmpty(child.Headline))
                                            {
                                                <span class="child-headline">@child.Headline</span>
                                            }
                                        </div>
                                    }
                                </details>
                            }
                        </div>
                    }
                </div>
            }
        }
    </section>
</div>

<style>
    .xray-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 1.5rem;
        align-items: start;
        min-width: 0; /* Prevent grid blowout */
    }

    .results-card {
        min-width: 0; /* Allow flex/grid shrinking */
        overflow: hidden;
    }

    @@media (max-width: 1000px) {
        .xray-layout {
            grid-template-columns: 1fr;
        }
    }

    .query-card {
        position: sticky;
        top: 1rem;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .form-group label {
        font-weight: 500;
        font-size: 0.85rem;
        color: #374151;
    }

    .form-group input,
    .form-group select {
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        font-size: 0.9rem;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #245dc1;
        box-shadow: 0 0 0 3px rgba(36, 93, 193, 0.15);
    }

    .form-hint {
        font-size: 0.75rem;
        color: #6b7280;
    }

    .form-actions {
        margin-top: 1.5rem;
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .status-badges {
        display: flex;
        gap: 0.5rem;
    }

    .badge-neutral {
        background-color: #e5e7eb;
        color: #374151;
    }

    .view-toggle {
        display: flex;
        gap: 0.25rem;
        margin-bottom: 1rem;
    }

    .view-toggle button {
        padding: 0.4rem 0.75rem;
        border: 1px solid #d1d5db;
        background: white;
        cursor: pointer;
        font-size: 0.85rem;
        border-radius: 6px;
    }

    .view-toggle button.active {
        background: #245dc1;
        color: white;
        border-color: #245dc1;
    }

    .rendered-output {
        background-color: #f8fafc;
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
        max-width: 100%;
    }

    .rendered-output pre {
        margin: 0;
        white-space: pre-wrap;
        word-wrap: break-word;
        word-break: break-word;
        font-size: 0.85rem;
        line-height: 1.5;
        max-width: 100%;
    }

    .structured-results {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .result-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .result-uri {
        font-family: monospace;
        font-size: 0.85rem;
        color: #245dc1;
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .result-confidence {
        font-weight: 600;
        color: #059669;
    }

    .result-kind {
        background: #e0e7ff;
        color: #3730a3;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .result-headline {
        color: #374151;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .result-structure,
    .result-snippet,
    .result-children {
        margin-top: 0.5rem;
    }

    .result-structure summary,
    .result-snippet summary,
    .result-children summary {
        cursor: pointer;
        font-size: 0.8rem;
        color: #6b7280;
    }

    .result-structure pre,
    .result-snippet pre {
        background: #f8fafc;
        padding: 0.75rem;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 0.8rem;
        margin: 0.5rem 0 0;
        white-space: pre-wrap;
        word-wrap: break-word;
        word-break: break-word;
        max-width: 100%;
    }

    .result-item {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1rem;
        min-width: 0;
        overflow: hidden;
    }

    .child-item {
        padding: 0.5rem;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .child-item:last-child {
        border-bottom: none;
    }

    .child-uri {
        font-family: monospace;
        font-size: 0.8rem;
        color: #6b7280;
    }

    .child-kind {
        background: #f3f4f6;
        padding: 0.1rem 0.4rem;
        border-radius: 3px;
        font-size: 0.7rem;
    }

    .child-headline {
        font-size: 0.8rem;
        color: #374151;
    }

    .placeholder-text {
        color: #9ca3af;
        text-align: center;
        padding: 2rem;
    }
</style>

@code {
    private int _tokenBudget = 1500;
    private XrayIntent _intent = XrayIntent.Explore;
    private string? _keywords;
    private string? _scope;
    private string? _boost;
    private string? _penalize;
    private int _limit;
    private bool _isExecuting;
    private bool _showRendered = true;
    private XrayQueryResult? _result;
    private string? _errorMessage;
    private CancellationTokenSource? _cts;

    private async Task ExecuteAsync()
    {
        if (_isExecuting) return;

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        _isExecuting = true;
        _errorMessage = null;
        _result = null;
        StateHasChanged();

        try
        {
            _result = await XrayService.ExecuteAsync(
                _tokenBudget,
                _intent,
                string.IsNullOrWhiteSpace(_scope) ? null : _scope,
                string.IsNullOrWhiteSpace(_keywords) ? null : _keywords,
                string.IsNullOrWhiteSpace(_boost) ? null : _boost,
                string.IsNullOrWhiteSpace(_penalize) ? null : _penalize,
                _limit > 0 ? _limit : null,
                _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Ignored
        }
        catch (Exception ex)
        {
            _errorMessage = ex.GetBaseException().Message;
        }
        finally
        {
            _isExecuting = false;
            StateHasChanged();
        }
    }

    private static string TruncateUri(string uri)
    {
        if (uri.Length <= 60) return uri;
        return "..." + uri[^57..];
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
