@page "/query"
@inject SqlExecutionService SqlExecutionService
@implements IDisposable

<PageTitle>Query Studio</PageTitle>

<h1>Query Studio</h1>

<div class="studio-grid">
    <section class="card editor-card">
        <div class="editor-header">
            <label for="sql-input">SQL</label>
            <span class="helper">Execute raw RepoQL/DuckDB SQL against the local index. <kbd>Ctrl+Enter</kbd> to run.</span>
        </div>
        <textarea id="sql-input"
                  class="sql-text"
                  spellcheck="false"
                  @bind="_sql"
                  @bind:event="oninput"
                  @onkeydown="HandleKeyDown"
                  placeholder="SELECT * FROM Files LIMIT 20;"></textarea>

        <div class="editor-controls">
            <div class="limit-group">
                <label for="row-limit">Row limit</label>
                <input id="row-limit"
                       type="number"
                       min="0"
                       placeholder="none"
                       value="@_rowLimitText"
                       @oninput="OnRowLimitChanged" />
                @if (_rowLimitInvalid)
                {
                    <span class="validation-hint">Enter a positive integer or leave blank.</span>
                }
            </div>

            <div class="button-group">
                @if (_isExecuting)
                {
                    <button class="btn secondary" type="button" @onclick="CancelQuery">
                        Cancel
                    </button>
                }
                <button class="btn primary"
                        type="button"
                        @onclick="RunAsync"
                        disabled="@IsRunDisabled">
                    @if (_isExecuting)
                    {
                        <span>Running...</span>
                    }
                    else
                    {
                        <span>Run</span>
                    }
                </button>
            </div>
        </div>
    </section>

    <section class="card results-card">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="error-callout">@_errorMessage</div>
        }
        else if (_isExecuting && _result is null)
        {
            <div class="loading">Executing query...</div>
        }
        else if (_result is not null)
        {
            <div class="results-header">
                <span class="result-count">
                    @if (_result.Truncated)
                    {
                        <text>@_result.Rows.Count rows shown, @_result.RowCount total</text>
                    }
                    else
                    {
                        <text>@_result.Rows.Count rows</text>
                    }
                </span>
                <span class="result-duration">@FormatDuration(_result.Duration)</span>
            </div>
            <SqlResultGrid Result="_result" />
        }
        else
        {
            <SqlResultGrid Result="null" />
        }
    </section>

    <!-- Help Panel -->
    <aside class="card help-card">
        <details>
            <summary>Quick Reference</summary>

            <div class="help-section">
                <h4>Common Views</h4>
                <ul class="help-list">
                    <li><code>Files</code> - All indexed documents with metadata</li>
                    <li><code>Types</code> - Classes, interfaces, structs across languages</li>
                    <li><code>Functions</code> - Methods and functions with signatures</li>
                    <li><code>Annotations</code> - Errors, warnings, and diagnostics</li>
                </ul>
            </div>

            <div class="help-section">
                <h4>Search Functions</h4>
                <ul class="help-list">
                    <li><code>search('query', k := 10)</code> - Semantic + lexical search</li>
                    <li><code>search_symbol('name')</code> - Find symbols by name</li>
                    <li><code>snippet('uri', 3)</code> - Get code context around a location</li>
                </ul>
            </div>

            <div class="help-section">
                <h4>Example Queries</h4>
                <ul class="help-list example-queries">
                    <li @onclick="() => SetQuery(ExampleQueries[0])">Files with errors</li>
                    <li @onclick="() => SetQuery(ExampleQueries[1])">Search for authentication</li>
                    <li @onclick="() => SetQuery(ExampleQueries[2])">List all classes</li>
                    <li @onclick="() => SetQuery(ExampleQueries[3])">Annotation summary</li>
                </ul>
            </div>
        </details>
    </aside>
</div>

<style>
    .studio-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        grid-template-rows: auto 1fr;
        gap: 1.5rem;
    }

    .editor-card {
        grid-column: 1;
        grid-row: 1;
    }

    .results-card {
        grid-column: 1;
        grid-row: 2;
        min-height: 300px;
    }

    .help-card {
        grid-column: 2;
        grid-row: 1 / 3;
    }

    .editor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .editor-header label {
        font-weight: 600;
    }

    .helper {
        font-size: 0.85rem;
        color: #64748b;
    }

    .helper kbd {
        background: #f1f5f9;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        font-size: 0.8rem;
        border: 1px solid #e2e8f0;
    }

    .sql-text {
        width: 100%;
        min-height: 120px;
        padding: 0.75rem;
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
        font-size: 0.9rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        resize: vertical;
    }

    .sql-text:focus {
        outline: none;
        border-color: #245dc1;
        box-shadow: 0 0 0 3px rgba(36, 93, 193, 0.15);
    }

    .editor-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.75rem;
    }

    .limit-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .limit-group input {
        width: 80px;
        padding: 0.4rem 0.5rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
    }

    .validation-hint {
        font-size: 0.8rem;
        color: #ef4444;
    }

    .button-group {
        display: flex;
        gap: 0.5rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        border: none;
    }

    .btn.primary {
        background: #245dc1;
        color: white;
    }

    .btn.primary:hover:not(:disabled) {
        background: #1e4fa8;
    }

    .btn.primary:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    .btn.secondary {
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .btn.secondary:hover {
        background: #f3f4f6;
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 0.75rem;
    }

    .result-count {
        font-size: 0.9rem;
        color: #374151;
    }

    .result-duration {
        font-size: 0.85rem;
        color: #64748b;
        background: #f1f5f9;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }

    .loading {
        color: #64748b;
        text-align: center;
        padding: 2rem;
    }

    .error-callout {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #991b1b;
        padding: 1rem;
        border-radius: 8px;
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.85rem;
        white-space: pre-wrap;
    }

    /* Help Panel */
    .help-card details {
        cursor: pointer;
    }

    .help-card summary {
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.5rem 0;
    }

    .help-section {
        margin-top: 1rem;
    }

    .help-section h4 {
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .help-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .help-list li {
        font-size: 0.85rem;
        padding: 0.35rem 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .help-list code {
        background: #f1f5f9;
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
        font-size: 0.8rem;
    }

    .example-queries li {
        cursor: pointer;
        color: #245dc1;
    }

    .example-queries li:hover {
        text-decoration: underline;
    }

    @@media (max-width: 900px) {
        .studio-grid {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto auto;
        }

        .help-card {
            grid-column: 1;
            grid-row: 3;
        }
    }
</style>

@code {
    private static readonly string[] ExampleQueries =
    [
        "SELECT uri, error_count, warning_count FROM Files WHERE error_count > 0 ORDER BY error_count DESC;",
        "SELECT * FROM search('authentication', k := 10);",
        "SELECT name, qualified_name, file_uri FROM Types WHERE type_kind = 'class' LIMIT 50;",
        "SELECT severity, rule_id, COUNT(*) as count FROM Annotations GROUP BY severity, rule_id ORDER BY count DESC;"
    ];

    private string _sql = "SELECT * FROM Files LIMIT 20;";
    private string _rowLimitText = "200";
    private bool _rowLimitInvalid;
    private bool _isExecuting;
    private SqlExecutionResult? _result;
    private string? _errorMessage;
    private CancellationTokenSource? _queryCts;

    private bool IsRunDisabled => _isExecuting || string.IsNullOrWhiteSpace(_sql) || _rowLimitInvalid;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Ctrl+Enter to run
        if (e.CtrlKey && e.Key == "Enter")
        {
            await RunAsync();
        }
    }

    private async Task RunAsync()
    {
        if (IsRunDisabled)
            return;

        ResetQueryCts(cancelCurrent: true);
        _queryCts = new CancellationTokenSource();

        await InvokeAsync(() =>
        {
            _isExecuting = true;
            _errorMessage = null;
            _result = null;
            StateHasChanged();
        });

        try
        {
            var limit = ParseRowLimit();
            var result = await SqlExecutionService.ExecuteAsync(_sql, limit, _queryCts.Token).ConfigureAwait(false);

            await InvokeAsync(() =>
            {
                _result = result;
            });
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() =>
            {
                _errorMessage = null; // Clear error on cancel
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _errorMessage = ex.GetBaseException().Message;
            });
        }
        finally
        {
            await InvokeAsync(() =>
            {
                _isExecuting = false;
                ResetQueryCts(cancelCurrent: false);
                StateHasChanged();
            });
        }
    }

    private void CancelQuery()
    {
        ResetQueryCts(cancelCurrent: true);
    }

    private void SetQuery(string query)
    {
        _sql = query;
    }

    private void OnRowLimitChanged(ChangeEventArgs args)
    {
        _rowLimitText = args.Value?.ToString() ?? string.Empty;
        _rowLimitInvalid = !string.IsNullOrWhiteSpace(_rowLimitText) && (!int.TryParse(_rowLimitText, out var parsed) || parsed < 0);
    }

    private int? ParseRowLimit()
    {
        if (string.IsNullOrWhiteSpace(_rowLimitText))
            return null;
        if (int.TryParse(_rowLimitText, out var parsed) && parsed > 0)
            return parsed;
        return null;
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMilliseconds < 1)
            return "<1ms";
        if (duration.TotalMilliseconds < 1000)
            return $"{duration.TotalMilliseconds:F0}ms";
        return $"{duration.TotalSeconds:F2}s";
    }

    private void ResetQueryCts(bool cancelCurrent)
    {
        var current = _queryCts;
        if (current is null)
            return;

        _queryCts = null;
        try
        {
            if (cancelCurrent)
            {
                current.Cancel();
            }
        }
        catch
        {
            // ignored
        }
        finally
        {
            current.Dispose();
        }
    }

    void IDisposable.Dispose()
    {
        ResetQueryCts(cancelCurrent: true);
    }
}
