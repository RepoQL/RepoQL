@page "/preview"
@using System
@using System.IO
@using System.Linq
@inject FormatPreviewService PreviewService
@implements IDisposable

<PageTitle>Format Preview</PageTitle>

<h1>Format Preview</h1>

<div class="preview-layout">
    <section class="card preview-inputs">
        <p>Drag a file here (or pick one) to run the Markdown hot-path parser out of band. Nothing is saved.</p>
        <div class="upload-panel">
            <InputFile OnChange="HandleFileChange" />
            @if (!string.IsNullOrEmpty(_uploadedSummary))
            {
                <div class="upload-summary">Selected: @_uploadedSummary</div>
            }
        </div>
        <div class="button-row">
            <button class="btn primary" type="button" disabled="@(_isRunning || _uploadedBytes is null)" @onclick="RunPreviewAsync">
                Preview selected file
            </button>
        </div>
        <span class="hint">Files up to 10&nbsp;MB are supported.</span>
    </section>

    <section class="card preview-results">
        @if (_isRunning)
        {
            <div class="loading">Running preview…</div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-callout">@_errorMessage</div>
        }
        else if (_result is null)
        {
            <p class="empty-state">Select a file to inspect its headline, summary, structure, and parsed nodes.</p>
        }
        else
        {
            var primaryArtifact = _result.Records.Artifacts.FirstOrDefault();
            <div class="summary-grid">
                <div>
                    <h3>Document summary</h3>
                    <dl>
                        <dt>Media type</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_result.MediaType) ? "(not set)" : _result.MediaType)</dd>
                        <dt>Digest</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_result.DigestHex) ? "(not computed)" : _result.DigestHex)</dd>
                        <dt>Artifacts</dt>
                        <dd>@_result.Records.Artifacts.Count</dd>
                        <dt>Nodes</dt>
                        <dd>@_result.Records.Nodes.Count</dd>
                        <dt>Annotations</dt>
                        <dd>@_result.Records.Annotations.Count</dd>
                    </dl>
                </div>
                <div>
                    <h3>Pipeline stages</h3>
                    <table class="stage-table">
                        <thead>
                            <tr>
                                <th>Stage</th>
                                <th>Status</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stage in _result.Stages)
                            {
                                <tr>
                                    <td>@stage.Stage</td>
                                    <td>@stage.Status</td>
                                    <td>@stage.DurationMs.ToString("F0") ms</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <section class="records-section">
                <h3>Headline / Summary / Structure</h3>
                @if (primaryArtifact is null)
                {
                    <div class="empty-state">The parser did not emit any artifact rows.</div>
                }
                else
                {
                    <dl class="document-summary">
                        <dt>Headline</dt>
                        <dd>@(string.IsNullOrWhiteSpace(primaryArtifact.Headline) ? "(none)" : primaryArtifact.Headline)</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(primaryArtifact.Summary))
                    {
                        <section class="overview-block">
                            <h4>Summary</h4>
                            <pre class="overview-pre">@primaryArtifact.Summary</pre>
                        </section>
                    }
                    else
                    {
                        <div class="empty-state">Summary not provided.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(primaryArtifact.Structure))
                    {
                        <section class="overview-block">
                            <h4>Structure</h4>
                            <pre class="overview-pre">@primaryArtifact.Structure</pre>
                        </section>
                    }
                    else
                    {
                        <div class="empty-state">Structure not provided.</div>
                    }
                }
            </section>

            <section class="records-section">
                <h3>Nodes</h3>
                @if (_result.Records.Nodes.Count == 0)
                {
                    <div class="empty-state">No nodes were emitted.</div>
                }
                else
                {
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th>Kind</th>
                                <th>URI</th>
                                <th>Headline</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var node in _result.Records.Nodes)
                            {
                                <tr>
                                    <td>@node.Kind</td>
                                    <td class="truncate">@node.Uri</td>
                                    <td>@node.Headline</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            <section class="records-section">
                <h3>Annotations</h3>
                @if (_result.Records.Annotations.Count == 0)
                {
                    <div class="empty-state">No annotations emitted by analyzers.</div>
                }
                else
                {
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th>Kind</th>
                                <th>Severity</th>
                                <th>Source</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var annotation in _result.Records.Annotations)
                            {
                                <tr>
                                    <td>@annotation.Kind</td>
                                    <td>@annotation.Severity</td>
                                    <td>@annotation.Source</td>
                                    <td class="truncate">@annotation.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    </section>
</div>

@code {
    private byte[]? _uploadedBytes;
    private string? _uploadedFileName;
    private string? _uploadedSummary;
    private string? _sourceUri;
    private bool _isRunning;
    private string? _errorMessage;
    private FormatPreviewResult? _result;

    private CancellationTokenSource _cts = new();
    private const long MaxUploadSize = 10 * 1024 * 1024;

    private async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        _uploadedBytes = null;
        _uploadedFileName = null;
        _uploadedSummary = null;
        _sourceUri = null;

        var file = e.File;
        if (file is null)
            return;

        await using var stream = file.OpenReadStream(MaxUploadSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _uploadedBytes = ms.ToArray();
        _uploadedFileName = string.IsNullOrWhiteSpace(file.Name) ? "uploaded.md" : file.Name;
        _uploadedSummary = $"{file.Name} ({file.Size / 1024.0:F1} KB)";
        _sourceUri = $"file:///uploaded/{Guid.NewGuid():N}/{_uploadedFileName}";
    }

    private async Task RunPreviewAsync()
    {
        if (_uploadedBytes is null)
        {
            _errorMessage = "Select a file first.";
            return;
        }

        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            _isRunning = true;
            _errorMessage = null;
            _result = null;

            var uri = _sourceUri ?? $"file:///uploaded/{Guid.NewGuid():N}/preview.md";
            var request = new FormatPreviewRequest(
                uri,
                _uploadedBytes,
                _uploadedFileName ?? "preview.md",
                null);

            var response = await PreviewService.RunPreviewAsync(request, token);
            _result = response;
            if (!response.Success)
            {
                _errorMessage = response.Error ?? "Preview failed.";
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
