    }

    .empty-state p {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .examples h4 {
        font-size: 0.9rem;
        color: #374151;
        margin-bottom: 0.75rem;
    }

    .examples ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .examples li {
        padding: 0.5rem;
        border-bottom: 1px solid #f3f4f6;
    }

    .examples code {
        background: #f1f5f9;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.85rem;
        cursor: pointer;
        color: #245dc1;
    }

    .examples code:hover {
        background: #e0e7ff;
    }

    .output-content {
        background: #f8fafc;
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
        max-height: 70vh;
        overflow-y: auto;
    }

    .output-content pre {
        margin: 0;
        white-space: pre-wrap;
        word-wrap: break-word;
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.85rem;
        line-height: 1.5;
    }
</style>

@code {
    private string _uri = "";
    private int _tokenBudget = 2000;
    private string _modifier = "none";

    private bool _isReading;
    private ReadResult? _result;
    private string? _errorMessage;
    private string? _validationError;
    private CancellationTokenSource? _readCts;

    private bool IsReadDisabled => _isReading || string.IsNullOrWhiteSpace(_uri);

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter")
        {
            await ExecuteReadAsync();
        }
    }

    private async Task ExecuteReadAsync()
    {
        if (IsReadDisabled)
            return;

        // Basic validation
        _validationError = ValidateUri(_uri);
        if (_validationError is not null)
            return;

        _readCts?.Cancel();
        _readCts?.Dispose();
        _readCts = new CancellationTokenSource();

        _isReading = true;
        _errorMessage = null;
        _result = null;
        StateHasChanged();

        try
        {
            var modifier = _modifier == "none" ? null : _modifier;
            var @params = new ReadParams(
                Uri: _uri.Trim(),
                TokenBudget: _tokenBudget,
                Modifier: modifier);

            _result = await ReadService.ReadAsync(@params, _readCts.Token);

            if (_result.Error is not null)
            {
                _errorMessage = _result.Error;
            }
        }
        catch (OperationCanceledException)
        {
            // Ignored
        }
        catch (Exception ex)
        {
            _errorMessage = ex.GetBaseException().Message;
        }
        finally
        {
            _isReading = false;
            StateHasChanged();
        }
    }

    private void CancelRead()
    {
        _readCts?.Cancel();
    }

    private void SetUri(string uri)
    {
        _uri = uri;
    }

    private static string? ValidateUri(string uri)
    {
        if (string.IsNullOrWhiteSpace(uri))
            return "URI is required";

        uri = uri.Trim();

        // Check for valid scheme
        if (!uri.StartsWith("file:///", StringComparison.OrdinalIgnoreCase) &&
            !uri.StartsWith("help:///", StringComparison.OrdinalIgnoreCase) &&
            !uri.StartsWith("github://", StringComparison.OrdinalIgnoreCase))
        {
            return "URI must start with a scheme (file:///, help:///, github://)";
        }

        return null;
    }

    private static string GetDetailExplanation(string detailLevel, int tokensUsed, int budget)
    {
        return detailLevel switch
        {
            "headline" => $"Showing headline because full content exceeds budget ({budget} tokens). Increase budget for more detail.",
            "structure" => $"Showing structure because full content exceeds budget ({budget} tokens). Increase budget for full content.",
            "tree" => "Showing directory tree view.",
            "answer" => "Showing LLM-synthesized answer.",
            _ => $"Showing {detailLevel} representation."
        };
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMilliseconds < 1)
            return "<1ms";
        if (duration.TotalMilliseconds < 1000)
            return $"{duration.TotalMilliseconds:F0}ms";
        return $"{duration.TotalSeconds:F2}s";
    }

    public void Dispose()
    {
        _readCts?.Cancel();
        _readCts?.Dispose();
    }
}
