@page "/read"
@inject ReadService ReadService
@implements IDisposable

<PageTitle>Read Testing</PageTitle>

<h1>Read Testing</h1>

<div class="read-layout">
    <section class="card params-card">
        <h2 style="margin-top: 0;">Read Parameters</h2>

        <div class="form-grid">
            <div class="form-group">
                <label for="uri">URI</label>
                <input id="uri"
                       type="text"
                       class="uri-input"
                       @bind="_uri"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="file:///src/App.cs or file:///src/**/*.md" />
                <span class="form-hint">Supports fragments (#line=10,20, #symbol=Name) and globs (**/*.cs)</span>
            </div>

            <div class="form-group">
                <label for="budget">Token Budget: @_tokenBudget</label>
                <input id="budget"
                       type="range"
                       min="50"
                       max="10000"
                       step="50"
                       @bind="_tokenBudget"
                       @bind:event="oninput" />
                <div class="budget-presets">
                    <button class="preset @(_tokenBudget == 100 ? "active" : "")" @onclick="() => _tokenBudget = 100">100</button>
                    <button class="preset @(_tokenBudget == 500 ? "active" : "")" @onclick="() => _tokenBudget = 500">500</button>
                    <button class="preset @(_tokenBudget == 2000 ? "active" : "")" @onclick="() => _tokenBudget = 2000">2000</button>
                    <button class="preset @(_tokenBudget == 5000 ? "active" : "")" @onclick="() => _tokenBudget = 5000">5000</button>
                </div>
                <span class="budget-preview">At @_tokenBudget tokens: @ReadService.PredictDetailLevel(_tokenBudget)</span>
            </div>

            <div class="form-group">
                <label for="modifier">Modifier</label>
                <select id="modifier" @bind="_modifier">
                    <option value="none">(None) - Default content</option>
                    <option value="tree">tree - Directory structure</option>
                    <option value="tree: folders">tree: folders - Folders only</option>
                    <option value="tree: headlines">tree: headlines - With summaries</option>
                    <option value="history">history - Git commits</option>
                    <option value="blame">blame - Git blame</option>
                    <option value="lint">lint - Diagnostics</option>
                    <option value="lint: errors">lint: errors - Errors only</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            @if (_isReading)
            {
                <button class="btn secondary" @onclick="CancelRead">Cancel</button>
            }
            <button class="btn primary" @onclick="ExecuteReadAsync" disabled="@IsReadDisabled">
                @if (_isReading)
                {
                    <text>Reading...</text>
                }
                else
                {
                    <text>Read</text>
                }
            </button>
        </div>

        @if (_validationError is not null)
        {
            <div class="validation-error">@_validationError</div>
        }
    </section>

    <section class="card output-card">
        @if (_result is not null && _result.Error is null)
        {
            <div class="output-header">
                <h2 style="margin: 0;">Output</h2>
                <div class="output-badges">
                    <span class="badge badge-tokens">@_result.TokensUsed / @_tokenBudget tokens</span>
                    @if (_result.DetailLevel is not null)
                    {
                        <span class="badge badge-level">@_result.DetailLevel</span>
                    }
                    @if (_result.FilesRead > 0)
                    {
                        <span class="badge badge-files">@_result.FilesRead files</span>
                    }
                    @if (_result.FilesOmitted > 0)
                    {
                        <span class="badge badge-omitted">@_result.FilesOmitted omitted</span>
                    }
                    <span class="badge badge-timing">@FormatDuration(_result.Duration)</span>
                </div>
            </div>

            @if (_result.DetailLevel is not null && _result.DetailLevel != "full")
            {
                <div class="detail-explanation">
                    @GetDetailExplanation(_result.DetailLevel, _result.TokensUsed, _tokenBudget)
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="error-callout">@_errorMessage</div>
        }
        else if (_isReading)
        {
            <div class="loading">
                <div class="loading-spinner"></div>
                <span>Reading content...</span>
            </div>
        }
        else if (_result is null)
        {
            <div class="empty-state">
                <p>Enter a URI and click Read to test the read tool.</p>
                <div class="examples">
                    <h4>Examples:</h4>
                    <ul>
                        <li><code @onclick='() => SetUri("file:///src/README.md")'>file:///src/README.md</code> - Single file</li>
                        <li><code @onclick='() => SetUri("file:///src/**/*.cs")'>file:///src/**/*.cs</code> - Glob pattern</li>
                        <li><code @onclick='() => SetUri("file:///src/App.cs#line=10,50")'>file:///src/App.cs#line=10,50</code> - Line range</li>
                        <li><code @onclick='() => SetUri("file:///src/App.cs#symbol=MyClass")'>file:///src/App.cs#symbol=MyClass</code> - Symbol</li>
                        <li><code @onclick='() => SetUri("help:///quickstart.md")'>help:///quickstart.md</code> - Embedded docs</li>
                    </ul>
                </div>
            </div>
        }
        else if (_result.Error is not null)
        {
            <div class="error-callout">@_result.Error</div>
        }
        else
        {
            <div class="output-content">
                <pre>@_result.Content</pre>
            </div>
        }
    </section>
</div>

<style>
    .read-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    @@media (max-width: 1000px) {
        .read-layout {
            grid-template-columns: 1fr;
        }
    }

    .params-card {
        position: sticky;
        top: 1rem;
    }

    .output-card {
        min-height: 400px;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .form-group label {
        font-weight: 500;
        font-size: 0.85rem;
        color: #374151;
    }

    .form-group input,
    .form-group select {
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        font-size: 0.9rem;
    }

    .uri-input {
        font-family: ui-monospace, SFMono-Regular, monospace;
    }

    .form-group input[type="range"] {
        padding: 0;
        height: 8px;
        margin-top: 0.5rem;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #245dc1;
        box-shadow: 0 0 0 3px rgba(36, 93, 193, 0.15);
    }

    .form-hint {
        font-size: 0.75rem;
        color: #6b7280;
    }

    .budget-presets {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .preset {
        padding: 0.25rem 0.6rem;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        background: white;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .preset:hover {
        border-color: #245dc1;
        color: #245dc1;
    }

    .preset.active {
        background: #245dc1;
        border-color: #245dc1;
        color: white;
    }

    .budget-preview {
        font-size: 0.8rem;
        color: #6b7280;
        font-style: italic;
        margin-top: 0.5rem;
    }

    .form-actions {
        margin-top: 1.5rem;
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        border: none;
    }

    .btn.primary {
        background: #245dc1;
        color: white;
    }

    .btn.primary:hover:not(:disabled) {
        background: #1e4fa8;
    }

    .btn.primary:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    .btn.secondary {
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .btn.secondary:hover {
        background: #f3f4f6;
    }

    .validation-error {
        margin-top: 1rem;
        padding: 0.75rem;
        background: #fef2f2;
        border: 1px solid #fca5a5;
        border-radius: 6px;
        color: #991b1b;
        font-size: 0.9rem;
    }

    .output-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e5e7eb;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .output-badges {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .badge {
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .badge-tokens {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-level {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-files {
        background: #e0e7ff;
        color: #3730a3;
    }

    .badge-omitted {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-timing {
