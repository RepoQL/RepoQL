@using RepoQL.Contracts

<div class="pipeline-view">
    @* Hot Path Section *@
    <div class="pipeline-section @(HotPath?.Active == true ? "active" : "idle")">
        <div class="section-header">
            <span class="section-icon">@(HotPath?.Active == true ? "■" : "□")</span>
            <span class="section-title">HOT PATH</span>
            @if (HotPath?.Active == true && HotPath.ThroughputPerSec > 0)
            {
                <span class="throughput">@FormatThroughput(HotPath.ThroughputPerSec)/sec</span>
            }
        </div>
        <div class="stage-flow">
            @foreach (var (stage, index) in GetHotPathStages().Select((s, i) => (s, i)))
            {
                @if (index > 0)
                {
                    <span class="arrow">→</span>
                }
                <div class="stage-node @(stage.Busy ? "busy" : "")">
                    <span class="stage-name">@stage.Name</span>
                    <span class="stage-metric">@GetStageMetric(stage)</span>
                </div>
            }
        </div>
        @if (HotPath?.Active == true && HotPath.Queued > 0)
        {
            <div class="queue-bar">
                <div class="queue-progress" style="width: @GetQueuePercent(HotPath)%"></div>
            </div>
            <div class="queue-label">@HotPath.Queued queued</div>
        }
    </div>

    @* Idle Processing Section *@
    <div class="pipeline-section @(IdleProcessing?.Active == true ? "active" : "idle")">
        <div class="section-header">
            <span class="section-icon">@(IdleProcessing?.Active == true ? "■" : "□")</span>
            <span class="section-title">IDLE PROCESSING</span>
            @if (IdleProcessing?.Active == true && !string.IsNullOrEmpty(IdleProcessing.CurrentPhase))
            {
                <span class="current-phase">@FormatPhase(IdleProcessing.CurrentPhase)</span>
            }
            else if (IdleProcessing?.LastRunItems > 0)
            {
                <span class="last-run">@FormatTimeAgo(IdleProcessing.LastRun)</span>
            }
        </div>
        <div class="stage-flow">
            @foreach (var (stage, index) in GetIdleStages().Select((s, i) => (s, i)))
            {
                @if (index > 0)
                {
                    <span class="arrow">→</span>
                }
                <div class="stage-node @GetIdleStageClass(stage)">
                    <span class="stage-name">@stage.Name</span>
                    <span class="stage-state">@GetIdleStageState(stage)</span>
                </div>
            }
        </div>
        @if (IdleProcessing?.Active == true && IdleProcessing.Total > 0)
        {
            <div class="queue-bar">
                <div class="queue-progress" style="width: @GetIdlePercent()%"></div>
            </div>
            <div class="queue-label">@IdleProcessing.Progress / @IdleProcessing.Total</div>
        }
        else if (IdleProcessing?.LastRunItems > 0)
        {
            <div class="last-run-stats">
                @IdleProcessing.LastRunItems items in @FormatDuration(IdleProcessing.LastRunDurationSec * 1000)
            </div>
        }
    </div>
</div>

<style>
    .pipeline-view {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pipeline-section {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 1rem;
        transition: all 0.2s;
    }

    .pipeline-section.active {
        background: #f0f9ff;
        border-color: #bae6fd;
    }

    .pipeline-section.idle {
        opacity: 0.8;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
    }

    .section-icon {
        font-size: 0.6rem;
    }

    .pipeline-section.active .section-header {
        color: #0369a1;
    }

    .throughput, .current-phase, .last-run {
        margin-left: auto;
        font-size: 0.7rem;
        font-weight: 500;
        background: #dbeafe;
        color: #1d4ed8;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
    }

    .stage-flow {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }

    .arrow {
        color: #9ca3af;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .stage-node {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.5rem 0.75rem;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        min-width: 70px;
        transition: all 0.2s;
    }

    .stage-node.busy {
        background: #dcfce7;
        border-color: #86efac;
    }

    .stage-node.done {
        background: #f3f4f6;
        border-color: #d1d5db;
    }

    .stage-node.pending {
        background: #fefce8;
        border-color: #fde047;
    }

    .stage-name {
        font-size: 0.7rem;
        font-weight: 600;
        color: #374151;
        text-transform: capitalize;
    }

    .stage-metric {
        font-size: 0.65rem;
        color: #6b7280;
        font-family: monospace;
    }

    .stage-state {
        font-size: 0.6rem;
        color: #9ca3af;
        text-transform: lowercase;
    }

    .stage-node.busy .stage-state {
        color: #166534;
    }

    .queue-bar {
        height: 4px;
        background: #e5e7eb;
        border-radius: 2px;
        margin-top: 0.5rem;
        overflow: hidden;
    }

    .queue-progress {
        height: 100%;
        background: #3b82f6;
        border-radius: 2px;
        transition: width 0.3s;
    }

    .queue-label {
        font-size: 0.7rem;
        color: #6b7280;
        text-align: center;
        margin-top: 0.25rem;
    }

    .last-run-stats {
        font-size: 0.75rem;
        color: #6b7280;
        text-align: center;
        margin-top: 0.5rem;
    }
</style>

@code {
    [Parameter] public HotPathStatus? HotPath { get; set; }
    [Parameter] public IdleProcessingStatus? IdleProcessing { get; set; }

    private record StageInfo(string Name, PipelineStage Stage, bool Busy, double AvgDurationMs, long ProcessedTotal);

    private IEnumerable<StageInfo> GetHotPathStages()
    {
        var stages = HotPath?.Stages ?? Enumerable.Empty<StageStatus>();

        // Define the hot path stages in order
        var stageOrder = new[] {
            (PipelineStage.Discover, "Discover"),
            (PipelineStage.Filter, "Filter"),
            (PipelineStage.Classify, "Classify"),
            (PipelineStage.Parse, "Parse"),
            (PipelineStage.Explore, "XRay"),
            (PipelineStage.Commit, "Commit")
        };

        foreach (var (stage, name) in stageOrder)
        {
            var found = stages.FirstOrDefault(s => s.Stage == stage);
            yield return new StageInfo(
                name,
                stage,
                found?.Busy ?? false,
                found?.AvgDurationMs ?? 0,
                found?.ProcessedTotal ?? 0);
        }
    }

    private IEnumerable<StageInfo> GetIdleStages()
    {
        var stages = IdleProcessing?.Stages ?? Enumerable.Empty<StageStatus>();

        // Define idle stages in order
        var stageOrder = new[] {
            (PipelineStage.Prune, "Prune"),
            (PipelineStage.StructEmbed, "Struct Embed"),
            (PipelineStage.VectorRefresh, "Vec Refresh"),
            (PipelineStage.MultiFileAnalysis, "Analysis")
        };

        foreach (var (stage, name) in stageOrder)
        {
            var found = stages.FirstOrDefault(s => s.Stage == stage);
            yield return new StageInfo(
                name,
                stage,
                found?.Busy ?? false,
                found?.AvgDurationMs ?? 0,
                found?.ProcessedTotal ?? 0);
        }
    }

    private string GetStageMetric(StageInfo stage)
    {
        if (stage.Busy && stage.AvgDurationMs > 0)
            return FormatDuration(stage.AvgDurationMs);
        if (stage.ProcessedTotal > 0)
            return FormatCount(stage.ProcessedTotal);
        return "-";
    }

    private string GetIdleStageClass(StageInfo stage)
    {
        if (stage.Busy) return "busy";

        var currentPhase = IdleProcessing?.CurrentPhase ?? "";
        var phaseOrder = new[] { "prune", "structure_embedding", "vector_refresh", "multi_file_analysis" };
        var stagePhase = stage.Stage switch
        {
            PipelineStage.Prune => "prune",
            PipelineStage.StructEmbed => "structure_embedding",
            PipelineStage.VectorRefresh => "vector_refresh",
            PipelineStage.MultiFileAnalysis => "multi_file_analysis",
            _ => ""
        };

        if (string.IsNullOrEmpty(currentPhase)) return "";

        var currentIdx = Array.IndexOf(phaseOrder, currentPhase);
        var stageIdx = Array.IndexOf(phaseOrder, stagePhase);

        if (stageIdx < currentIdx) return "done";
        if (stageIdx > currentIdx) return "pending";
        return "";
    }

    private string GetIdleStageState(StageInfo stage)
    {
        if (stage.Busy) return "active";

        var cls = GetIdleStageClass(stage);
        return cls switch
        {
            "done" => "done",
            "pending" => "pending",
            _ => "idle"
        };
    }

    private double GetQueuePercent(HotPathStatus hp)
    {
        var total = hp.Queued + hp.InProgress;
        return total > 0 ? (double)hp.InProgress / total * 100 : 0;
    }

    private double GetIdlePercent()
    {
        var ip = IdleProcessing;
        return ip?.Total > 0 ? (double)(ip.Progress) / ip.Total * 100 : 0;
    }

    private static string FormatDuration(double ms)
    {
        if (ms < 1) return "<1ms";
        if (ms < 1000) return $"{ms:F0}ms";
        if (ms < 60000) return $"{ms / 1000:F1}s";
        return $"{ms / 60000:F1}m";
    }

    private static string FormatThroughput(double itemsPerSec)
    {
        if (itemsPerSec < 1) return "<1";
        if (itemsPerSec < 1000) return $"{itemsPerSec:F0}";
        return $"{itemsPerSec / 1000:F1}k";
    }

    private static string FormatCount(long count)
    {
        if (count < 1000) return count.ToString();
        if (count < 1000000) return $"{count / 1000.0:F1}k";
        return $"{count / 1000000.0:F1}M";
    }

    private static string FormatPhase(string phase) => phase switch
    {
        "prune" => "Pruning",
        "structure_embedding" => "Struct Embed",
        "vector_refresh" => "Vec Refresh",
        "multi_file_analysis" => "Analysis",
        _ => phase
    };

    private static string FormatTimeAgo(Google.Protobuf.WellKnownTypes.Timestamp? ts)
    {
        if (ts == null) return "never";
        var time = ts.ToDateTimeOffset();
        if (time == default) return "never";

        var diff = DateTimeOffset.UtcNow - time;
        if (diff.TotalSeconds < 5) return "just now";
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        return $"{(int)diff.TotalHours}h ago";
    }
}
