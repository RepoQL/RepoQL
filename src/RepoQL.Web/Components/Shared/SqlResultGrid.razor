@if (Result is null)
{
    <MudText Typo="Typo.body1" Class="result-placeholder">Run a query to see results.</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Gap="1" Class="result-summary">
        <MudText Typo="Typo.subtitle2">@($"{Result.RowCount:N0} row(s) returned")</MudText>
        @if (Result.Truncated)
        {
            <MudChip Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.WarningAmber">
                Truncated by limit
            </MudChip>
        }
    </MudStack>

    <MudDataGrid T="IReadOnlyList<string>" Items="@Result.Rows"
                 Dense="true"
                 Hover="true"
                 Virtualize="true"
                 FixedHeader="true"
                 Height="420px"
                 NoRecordsContent="NoRowsContent">
        <Columns>
            @for (var columnIndex = 0; columnIndex < Result.Columns.Count; columnIndex++)
            {
                var index = columnIndex;
                var title = string.IsNullOrWhiteSpace(Result.Columns[index]) ? $"Column {index + 1}" : Result.Columns[index];
                <PropertyColumn T="IReadOnlyList<string>"
                                TProperty="string"
                                Title="@title"
                                Property="row => row.Count > index ? row[index] : string.Empty"
                                CanGroup="false"
                                CanFilter="false" />
            }
        </Columns>
    </MudDataGrid>
}

@code {
    [Parameter]
    public SqlExecutionResult? Result { get; set; }

    private static readonly RenderFragment NoRowsContent = @<MudText Typo="Typo.body2">No rows</MudText>;
}
