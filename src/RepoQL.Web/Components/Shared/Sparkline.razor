@* Simple SVG sparkline for displaying time-series data *@

<svg class="sparkline @Class" viewBox="0 0 100 20" preserveAspectRatio="none">
    @if (_points.Length > 0)
    {
        <polyline
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            points="@_points" />
    }
</svg>

@code {
    private string _points = "";

    [Parameter]
    public IEnumerable<double>? Data { get; set; }

    [Parameter]
    public string Class { get; set; } = "";

    protected override void OnParametersSet()
    {
        _points = CalculatePoints();
    }

    private string CalculatePoints()
    {
        if (Data is null)
            return "";

        var values = Data.ToList();
        if (values.Count < 2)
            return "";

        var max = values.Max();
        var min = values.Min();
        var range = max - min;
        if (range == 0)
            range = 1; // Avoid division by zero

        var points = new List<string>();
        for (int i = 0; i < values.Count; i++)
        {
            var x = i * 100.0 / (values.Count - 1);
            var y = 20 - ((values[i] - min) / range * 18); // Leave 1px margin top/bottom
            points.Add($"{x:F1},{y:F1}");
        }

        return string.Join(" ", points);
    }
}
