    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\RepoQL.Contracts\RepoQL.Contracts.csproj" />
      <ProjectReference Include="..\RepoQL.Embeddings\RepoQL.Embeddings.csproj" />
      <ProjectReference Include="..\RepoQL.Explore\RepoQL.Explore.csproj" />
      <ProjectReference Include="..\RepoQL.FileSystem\RepoQL.FileSystem.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="RepoQL.Data.DuckDB.Tests" />
    </ItemGroup>

</Project>
