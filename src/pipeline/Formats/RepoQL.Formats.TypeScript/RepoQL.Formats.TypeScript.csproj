<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantCulture>true</InvariantCulture>
    <NodeHelperDir>$(MSBuildThisFileDirectory)Node</NodeHelperDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\contracts\RepoQL.Contracts\RepoQL.Contracts.csproj" />
    <ProjectReference Include="..\..\RepoQL.Indexing\RepoQL.Indexing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Node\\ts-parser.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Node\\package.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Node\\node_modules\\**\\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema/**/*.sql" />
  </ItemGroup>

  <!-- Auto-install TypeScript npm dependency if missing -->
  <Target Name="NpmInstall" BeforeTargets="BeforeBuild" Condition="!Exists('$(NodeHelperDir)/node_modules/typescript')">
    <Message Importance="high" Text="Installing TypeScript npm dependencies..." />
    <Exec Command="npm ci --silent" WorkingDirectory="$(NodeHelperDir)" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="NpmCiExitCode" />
    </Exec>
    <!-- Fallback to npm install if npm ci fails (e.g., no package-lock.json) -->
    <Exec Command="npm install --silent" WorkingDirectory="$(NodeHelperDir)" Condition="'$(NpmCiExitCode)' != '0'" />
      <ItemGroup>
          <None Remove="Node\\ts-parser.js" />
          <None Remove="Node\\package.json" />
          <None Remove="Node\\node_modules\\**\\*" />
          
          <None Include="Node\\ts-parser.js" CopyToOutputDirectory="PreserveNewest" />
          <None Include="Node\\package.json" CopyToOutputDirectory="PreserveNewest" />
          <None Include="Node\\node_modules\\**\\*" CopyToOutputDirectory="PreserveNewest" />
      </ItemGroup>
  </Target>

</Project>
