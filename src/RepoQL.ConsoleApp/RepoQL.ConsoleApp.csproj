<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.3.12</Version>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <AssemblyName>repoql</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <IsPackable>true</IsPackable>
        <ToolCommandName>repoql</ToolCommandName>
        <PackageId>RepoQL.Tool</PackageId>
        <PackageOutputPath>$(ArtifactsDirectory)/packages</PackageOutputPath>
        <RollForward>Major</RollForward>
        <PublishSingleFile>true</PublishSingleFile>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <StripSymbols>true</StripSymbols>
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- Keep trimming enabled but manually preserve native duckdb below -->
        <PublishTrimmed>true</PublishTrimmed>
        <!-- keep symbols out of nupkg -->
        <DebugType>none</DebugType>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <ApplicationIcon>..\..\repoql.ico</ApplicationIcon>
    </PropertyGroup>
    
    <PropertyGroup Condition="$(RuntimeIdentifier) != ''">
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ConsoleAppFramework" Version="5.6.1">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="DuckDB.NET.Data.Full" Version="1.4.1" GeneratePathProperty="true" />
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.1" />
      <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" GeneratePathProperty="true" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
        <PackageReference Include="Spectre.Console" Version="0.50.0" />
        <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.3" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.8" />
        <PackageReference Include="Google.Protobuf" Version="3.27.1" />
        <PackageReference Include="Grpc.AspNetCore" Version="2.62.0" />
        <PackageReference Include="Grpc.AspNetCore.Server" Version="2.62.0" />
        <PackageReference Include="Grpc.HealthCheck" Version="2.62.0" />
        <PackageReference Include="OpenTelemetry" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Api" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
    </ItemGroup>

    <!-- Ensure duckdb native library is always copied alongside trimmed single-file publishes -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-x64\native\duckdb.dll"
                 Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-x64\native\duckdb.dll')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>duckdb.dll</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-arm64\native\duckdb.dll"
                 Condition="'$(RuntimeIdentifier)' == 'win-arm64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\win-arm64\native\duckdb.dll')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>duckdb.dll</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\osx\native\libduckdb.dylib"
                 Condition="('$(RuntimeIdentifier)' == 'osx-arm64' or '$(RuntimeIdentifier)' == 'osx-x64') and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\osx\native\libduckdb.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libduckdb.dylib</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-x64\native\libduckdb.so"
                 Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-x64\native\libduckdb.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libduckdb.so</Link>
        </Content>
        <Content Include="$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-arm64\native\libduckdb.so"
                 Condition="'$(RuntimeIdentifier)' == 'linux-arm64' and Exists('$(PkgDuckDB_NET_Bindings_Full)\runtimes\linux-arm64\native\libduckdb.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <Link>libduckdb.so</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\RepoQL.Contracts\RepoQL.Contracts.csproj" />
    <ProjectReference Include="..\RepoQL.Protocol\RepoQL.Protocol.csproj" />
    <ProjectReference Include="..\RepoQL.Data.DuckDB\RepoQL.Data.DuckDB.csproj" />
    <ProjectReference Include="..\RepoQL.Core\RepoQL.Core.csproj" />
    <ProjectReference Include="..\Indexing\RepoQL.Indexing\RepoQL.Indexing.csproj" />
    <ProjectReference Include="..\RepoQL.Documentation\RepoQL.Documentation.csproj" />
    <ProjectReference Include="..\RepoQL.Templating\RepoQL.Templating.csproj" />
    <ProjectReference Include="..\RepoQL.Xray\RepoQL.Xray.csproj" />
  </ItemGroup>

    
    
    <!-- Prefer a prebuilt zip committed once; otherwise embed individual model files -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\EmbeddingsModel.zip" LogicalName="Embeddings.Model.embeddings.zip" Condition="Exists('$(MSBuildThisFileDirectory)Resources\\EmbeddingsModel.zip')" />
  </ItemGroup>

    <!-- Include platform native onnxruntime binaries for non-Windows self-contained publishes. -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.dylib</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime_providers_shared.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-arm64\native\libonnxruntime_providers_shared.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.dylib</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.dylib</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime_providers_shared.dylib" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\osx-x64\native\libonnxruntime_providers_shared.dylib')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.dylib</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.so</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime_providers_shared.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime_providers_shared.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.so</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime.so</Link>
        </Content>
        <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime_providers_shared.so" Condition="Exists('$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-arm64\native\libonnxruntime_providers_shared.so')">
            <Pack>false</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>libonnxruntime_providers_shared.so</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Templates/**/*.liquid" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\repoql.ico">
        <Link>repoql.ico</Link>
      </None>
      <None Update="appsettings.Development.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
