<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\pipeline\Formats\RepoQL.Formats.Cpp\RepoQL.Formats.Cpp.csproj" />
    <ProjectReference Include="..\RepoQL.Testing\RepoQL.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.cpp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.h" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.hpp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
