{
  "displayName": "RepoQL Cloud Services",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "xPos": 0, "yPos": 0, "width": 48, "height": 4,
        "widget": {
          "title": "",
          "text": {
            "content": "## Service Health — Golden Signals",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0, "yPos": 4, "width": 24, "height": 16,
        "widget": {
          "title": "Request Rate by Service",
          "xyChart": {
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=monitoring.regex.full_match(\"repoql-(embedding|embedding-writer|inference)\")",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.label.\"service_name\"",
                        "metric.label.\"response_code_class\""
                      ]
                    }
                  }
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": { "scale": "LINEAR", "label": "req/s" }
          }
        }
      },
      {
        "xPos": 24, "yPos": 4, "width": 24, "height": 16,
        "widget": {
          "title": "Request Latency (p50 / p95 / p99)",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "p50 ${resource.label.service_name}",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=monitoring.regex.full_match(\"repoql-(embedding|embedding-writer|inference)\")",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "groupByFields": ["resource.label.\"service_name\""]
                    }
                  }
                },
                "plotType": "LINE"
              },
              {
                "legendTemplate": "p95 ${resource.label.service_name}",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=monitoring.regex.full_match(\"repoql-(embedding|embedding-writer|inference)\")",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "groupByFields": ["resource.label.\"service_name\""]
                    }
                  }
                },
                "plotType": "LINE"
              },
              {
                "legendTemplate": "p99 ${resource.label.service_name}",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=monitoring.regex.full_match(\"repoql-(embedding|embedding-writer|inference)\")",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "groupByFields": ["resource.label.\"service_name\""]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "scale": "LINEAR", "label": "ms" }
          }
        }
      },
      {
        "xPos": 0, "yPos": 20, "width": 24, "height": 16,
        "widget": {
          "title": "Error Rate (5xx / total)",
          "xyChart": {
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilterRatio": {
                    "numerator": {
                      "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=monitoring.regex.full_match(\"repoql-(embedding|embedding-writer|inference)\") metric.label.\"response_code_class\"=\"5xx\"",
                      "aggregation": {
                        "alignmentPeriod": "60s",
                        "perSeriesAligner": "ALIGN_RATE",
                        "crossSeriesReducer": "REDUCE_SUM",
                        "groupByFields": ["resource.label.\"service_name\""]
                      }
                    },
                    "denominator": {
                      "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=monitoring.regex.full_match(\"repoql-(embedding|embedding-writer|inference)\")",
                      "aggregation": {
                        "alignmentPeriod": "60s",
                        "perSeriesAligner": "ALIGN_RATE",
                        "crossSeriesReducer": "REDUCE_SUM",
                        "groupByFields": ["resource.label.\"service_name\""]
                      }
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "scale": "LINEAR", "label": "ratio" }
          }
        }
      },
      {
        "xPos": 24, "yPos": 20, "width": 24, "height": 16,
        "widget": {
          "title": "Request Count by Response Code",
          "xyChart": {
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=monitoring.regex.full_match(\"repoql-(embedding|embedding-writer|inference)\")",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"response_code\"",
                        "resource.label.\"service_name\""
                      ]
                    }
                  }
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": { "scale": "LINEAR", "label": "req/s" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 36, "width": 48, "height": 4,
