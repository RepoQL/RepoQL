      },
      {
        "xPos": 0,
        "yPos": 52,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "",
          "text": {
            "content": "## Eventarc Pipeline (Staging to Writer)",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 56,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Pub/Sub Push Delivery",
          "xyChart": {
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/push_request_count\" resource.type=\"pubsub_subscription\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.\"response_code_class\""]
                    }
                  }
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": { "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 56,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Pub/Sub Backlog (Undelivered Messages)",
          "xyChart": {
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" resource.type=\"pubsub_subscription\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 72,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "",
          "text": {
            "content": "## Storage",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 76,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Bucket Object Count",
          "xyChart": {
            "dataSets": [
              {
                "minAlignmentPeriod": "86400s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"storage.googleapis.com/storage/object_count\" resource.type=\"gcs_bucket\"",
                    "aggregation": {
                      "alignmentPeriod": "86400s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["resource.label.\"bucket_name\""]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 76,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Bucket Storage Size",
          "xyChart": {
            "dataSets": [
              {
                "minAlignmentPeriod": "86400s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"storage.googleapis.com/storage/total_bytes\" resource.type=\"gcs_bucket\"",
                    "aggregation": {
                      "alignmentPeriod": "86400s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["resource.label.\"bucket_name\""]
