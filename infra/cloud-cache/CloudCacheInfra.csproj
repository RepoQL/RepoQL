<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pulumi" Version="3.101.2" />
    <PackageReference Include="Pulumi.Cloudflare" Version="6.13.0" />
    <PackageReference Include="Pulumi.Gcp" Version="9.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="dashboard.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
