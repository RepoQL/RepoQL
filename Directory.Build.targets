<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Include all the target files under /build -->
    <Import Project="$(BuildExtensionsDirectory)*.targets"/>

    <!-- Fix Antlr4BuildTasks which uses USERPROFILE (doesn't exist on macOS/Linux).
         This must be static (not in a Target) to be evaluated before Antlr4BuildTasks
         tries to resolve the jar path during target dependency resolution.
         Use HOME on Unix, USERPROFILE on Windows. ItemGroup Update overrides existing metadata. -->
    <PropertyGroup>
        <_AntlrHome Condition="'$(USERPROFILE)' != ''">$(USERPROFILE)</_AntlrHome>
        <_AntlrHome Condition="'$(_AntlrHome)' == '' AND '$(HOME)' != ''">$(HOME)</_AntlrHome>
    </PropertyGroup>
    <ItemGroup Condition="'$(_AntlrHome)' != ''">
        <Antlr4 Update="@(Antlr4)">
            <AntlrToolJarDownloadDir>$(_AntlrHome)/.m2/</AntlrToolJarDownloadDir>
            <JavaDownloadDirectory>$(_AntlrHome)/.jre/</JavaDownloadDirectory>
        </Antlr4>
    </ItemGroup>
</Project>
