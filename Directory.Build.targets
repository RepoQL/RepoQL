<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Include all the target files under /build -->
    <Import Project="$(BuildExtensionsDirectory)*.targets"/>

    <!-- Fix Antlr4BuildTasks using USERPROFILE which doesn't exist on macOS/Linux.
         - Must use ItemGroup Update (not ItemDefinitionGroup) to override values already set by Antlr4BuildTasks.targets
         - Must use GetFolderPath(SpecialFolder.UserProfile) which is the reliable cross-platform .NET API
           (environment variables like $(HOME) don't work as MSBuild properties on macOS)
         - No conditional - GetFolderPath always returns a valid path on all platforms -->
    <ItemGroup>
        <Antlr4 Update="@(Antlr4)">
            <AntlrToolJarDownloadDir>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.m2/</AntlrToolJarDownloadDir>
            <JavaDownloadDirectory>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.jre/</JavaDownloadDirectory>
        </Antlr4>
    </ItemGroup>

    <!-- TUnit sees it as a test project otherwise and it exits with code 8 (no tests run) which confuses claude -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'RepoQL.Testing'">
        <IsTestProject>false</IsTestProject>
        <UseTestingPlatform>false</UseTestingPlatform>
        <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>
</Project>
