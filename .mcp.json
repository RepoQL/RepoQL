{
  "mcpServers": {
    "repoql": {
      "type": "stdio",
      "command": "artifacts\\publish\\repoql.exe",
      "args": ["mcp"]
    },
    "aspire-dashboard": {
      "type": "http",
      "url": "http://localhost:15011/mcp"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}