{
  "name": "@repoql/repoql",
  "version": "1.0.5",
  "description": "OpenClaw plugin for RepoQL - queryable repository intelligence powered by rql",
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -R src/proto dist/src/proto && cp src/catalog.json dist/src/catalog.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync": "node scripts/sync.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "repoql",
    "code-understanding",
    "grpc"
  ],
  "author": "Stuart Wilson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RepoQL/RepoQL.git",
    "directory": "clawdbot"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.9",
      "minGatewayVersion": "2026.6.9"
    },
    "build": {
      "openclawVersion": "2026.6.9",
      "pluginSdkVersion": "2026.6.9"
    },
    "install": {
      "minHostVersion": ">=2026.6.9"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "^2026.9.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
