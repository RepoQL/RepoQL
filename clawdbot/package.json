{
  "name": "@openclaw/repoql",
  "version": "1.0.0",
  "description": "OpenClaw plugin for RepoQL - queryable repository intelligence powered by rql",
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "src/proto",
    "src/descriptions",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/proto dist/src/descriptions && cp src/proto/*.proto dist/src/proto/ && cp src/descriptions/*.md dist/src/descriptions/",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "repoql",
    "code-understanding",
    "grpc"
  ],
  "author": "Stuart Wilson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stueeey/RepoQL.Public.git",
    "directory": "clawdbot"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.6.9",
      "pluginSdkVersion": "2026.6.9"
    },
    "install": {
      "minHostVersion": ">=2026.3.24-beta.2"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "^2026.6.8",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
