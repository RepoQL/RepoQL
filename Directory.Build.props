<Project>

    <!-- 
        Anything in this file will be applied to all projects built in this repository
        This file is injected at the top of your project files
    -->

    <!-- Constants for this repository -->
    <PropertyGroup>
        <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
        <NoWarn>$(NoWarn);CA1056;CA1054;CA1034</NoWarn>
    </PropertyGroup>

    <!-- Apply test-project warning policy consistently across all *.Tests projects -->
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">
        <WarningLevel>1</WarningLevel>
        <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">
        <PackageReference Include="Microsoft.Build.Framework"
                          ExcludeAssets="runtime"
                          PrivateAssets="all" />
    </ItemGroup>

    <!-- Repository Areas -->
    <PropertyGroup>
        <!-- Msbuild extensions to apply everywhere -->
        <BuildExtensionsDirectory>$(RepositoryRoot)build/</BuildExtensionsDirectory>
        <!-- Outputs for build and publish steps -->
        <ArtifactsDirectory>$(RepositoryRoot)artifacts</ArtifactsDirectory>
    </PropertyGroup>

    <!-- Include all the target files under /build -->
    <Import Project="$(BuildExtensionsDirectory)*.props"/>

    <!-- RepoQL analyzers — applied to all projects except the analyzer itself and AOT publishes -->
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'RepoQL.Analyzers' and '$(PublishAot)' != 'true' and '$(PublishAot)' != 'True'">
        <ProjectReference Include="$(RepositoryRoot)src/RepoQL.Analyzers/RepoQL.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="All" />
    </ItemGroup>

</Project>
