{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/run-hook.cmd\" session-start",
        "timeout": 240
      }
    ],
    "preToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/run-hook.cmd\" concepts-write-hook",
        "matcher": "^Write$",
        "timeout": 5
      }
    ]
  }
}
