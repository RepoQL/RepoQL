{
  "description": "Load concepts before writes, define known vocabulary after reads, and inject the concepts index at session start.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/concepts-write-hook.sh",
            "timeout": 5,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading relevant RepoQL concepts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/session-start.sh",
            "command_windows": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/scripts/session-start.ps1\"",
            "timeout": 240,
            "additionalContextLimit": 12000,
            "statusMessage": "Loading the RepoQL concepts index"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Read|read_file|mcp__.*[Rr][Ee][Pp][Oo][Qq][Ll].*__read)$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/vocabulary-read-hook.sh",
            "timeout": 5,
            "additionalContextLimit": 2500,
            "statusMessage": "Loading repository vocabulary"
          }
        ]
      }
    ]
  }
}
