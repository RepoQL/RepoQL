{
  "modules": [
    "./display/register.tsx"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/concepts-write-hook.cmd\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-before-command-hook.cmd\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.cmd\"",
            "timeout": 240
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Read|read_file|mcp__.*[Rr][Ee][Pp][Oo][Qq][Ll].*__read)$",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/vocabulary-read-hook.cmd\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Read)$",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-track-hook.cmd\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__(.*[Rr][Ee][Pp][Oo][Qq][Ll].*|rql)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-check-hook.cmd\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Bash|Grep|Glob)$",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-command-hook.cmd\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-subagent-hook.cmd\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
