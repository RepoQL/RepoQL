<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <!-- Don't include the current folder by default, includes should be explicit -->
        <EnableDefaultItems>false</EnableDefaultItems>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsAotCompatible>false</IsAotCompatible>
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(RepositoryRoot)*.*" Exclude="$(RepositoryRoot)*.user" Link="%(Filename)"/>
        <None Include="$(RepositoryRoot)src/**/*.md" Link="[Documentation]\src\%(RecursiveDir)%(Filename)"/>
        <None Include="$(RepositoryRoot)docs/**/*.*" Link="[Documentation]\docs\%(RecursiveDir)%(Filename)"/>
        <None Include="$(RepositoryRoot)build/**/*.*" Link="[Build]\%(RecursiveDir)%(Filename)"/>
        <None Include="$(RepositoryRoot).github/**/*.*" Link="[Pipelines]\%(RecursiveDir)%(Filename)"/>
        <None Remove="artifacts\**" />
    </ItemGroup>

</Project>
